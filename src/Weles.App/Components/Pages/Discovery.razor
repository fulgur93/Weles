@page "/discovery"
@using Weles.Infrastructure.Discovery
@using Weles.Infrastructure.Scanning
@inject LocalNetworkDiscovery LocalNetwork
@inject ScanTargetService Targets
@inject NavigationManager Navigation

<PageTitle>Network Discovery · WELES</PageTitle>

<div class="page-header">
    <div>
        <h1>Network Discovery</h1>
        <p class="page-subtitle">Zdefiniuj i zatwierdź zakres, a potem uruchom wykrywanie urządzeń, portów i usług. WELES skanuje wyłącznie zatwierdzone zakresy.</p>
    </div>
    <button class="btn btn-primary" @onclick="NewScope"><Icon Name="layers" Size="16" /> Nowy zakres</button>
</div>

<section class="card">
    <div class="card-title"><Icon Name="discovery" /> Sieci tego komputera</div>
    @if (_interfaces.Count == 0)
    {
        <p class="muted">Nie wykryto aktywnych interfejsów IPv4 (poza loopback).</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Interfejs</th><th>Adres</th><th>Sieć</th><th>Brama</th><th>MAC / producent</th><th></th></tr></thead>
                <tbody>
                    @foreach (var nic in _interfaces)
                    {
                        <tr>
                            <td><strong>@nic.Name</strong><div class="muted small">@nic.Type</div></td>
                            <td class="mono">@nic.Address/@nic.PrefixLength</td>
                            <td class="mono">@nic.NetworkCidr<div class="muted small">@nic.HostCount adresów</div></td>
                            <td class="mono">@(nic.Gateway ?? "—")</td>
                            <td><span class="mono">@(nic.MacAddress ?? "—")</span><div class="muted small">@nic.Vendor</div></td>
                            <td class="right">
                                <button class="btn btn-ghost btn-sm" @onclick="() => ScopeFromInterface(nic)">Utwórz zakres @nic.SuggestedScope</button>
                                @if (nic.Note is not null) { <div class="muted small">@nic.Note</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (_editor is not null)
{
    <section class="card editor">
        <div class="card-title"><Icon Name="layers" /> @(_editingId is null ? "Nowy zakres skanowania" : "Edycja zakresu")</div>
        @if (_editingId is not null)
        {
            <div class="alert alert-warn"><Icon Name="alert" Size="15" /> Zapisanie zmian cofa zatwierdzenie zakresu – trzeba go zatwierdzić ponownie.</div>
        }
        <div class="form-grid">
            <label class="field"><span>Nazwa</span><input class="input" @bind="_editor.Name" maxlength="200" placeholder="np. Biuro – LAN" /></label>
            <label class="field"><span>Opis (opcjonalnie)</span><input class="input" @bind="_editor.Description" maxlength="2000" /></label>
            <label class="field">
                <span>Adresy do skanowania</span>
                <textarea class="input mono" rows="5" @bind="_editor.Include" placeholder="192.168.1.0/24&#10;10.0.0.10-10.0.0.50&#10;nas.firma.local"></textarea>
                <small class="muted">IP, CIDR (maks. /16), zakres <code>a.b.c.d-e</code> lub domena – jeden wpis w wierszu.</small>
            </label>
            <label class="field">
                <span>Wykluczenia</span>
                <textarea class="input mono" rows="5" @bind="_editor.Exclude" placeholder="192.168.1.1&#10;192.168.1.200-254"></textarea>
                <small class="muted">Wykluczenia mają pierwszeństwo przed listą adresów.</small>
            </label>
        </div>
        <label class="checkbox">
            <input type="checkbox" @bind="_editor.AllowPublic" />
            <span>Zezwól na adresy publiczne (Internet) – <strong>tylko jeśli masz pisemne uprawnienie do ich testowania</strong></span>
        </label>

        @if (_editorErrors.Count > 0)
        {
            <div class="alert alert-bad"><ul>@foreach (var e in _editorErrors) { <li>@e</li> }</ul></div>
        }
        @if (_preview is not null)
        {
            <div class="alert @(_preview.Errors.Count > 0 ? "alert-bad" : "alert-info")">
                @if (_preview.Errors.Count > 0)
                {
                    <ul>@foreach (var e in _preview.Errors) { <li>@e</li> }</ul>
                }
                else
                {
                    <div><strong>@_preview.AddressCount</strong> adresów do sprawdzenia, np. <span class="mono">@string.Join(", ", _preview.Sample)</span>@(_preview.AddressCount > _preview.Sample.Count ? "…" : "")</div>
                }
                @foreach (var w in _preview.Warnings) { <div class="small">⚠ @w</div> }
            </div>
        }

        <div class="actions">
            <button class="btn btn-ghost" @onclick="PreviewAsync" disabled="@_busy"><Icon Name="monitoring" Size="15" /> Podgląd zakresu</button>
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">Zapisz</button>
            <button class="btn btn-ghost" @onclick="CloseEditor">Anuluj</button>
        </div>
    </section>
}

<section class="card">
    <div class="card-title"><Icon Name="lock" /> Zakresy skanowania</div>
    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert-bad" : "alert-ok")">@_message</div>
    }
    @if (_targets is null)
    {
        <p class="muted">Wczytywanie…</p>
    }
    else if (_targets.Count == 0)
    {
        <div class="empty">
            <p>Brak zdefiniowanych zakresów. Utwórz zakres z wykrytej sieci powyżej albo dodaj własny.</p>
        </div>
    }
    else
    {
        <div class="scope-list">
            @foreach (var t in _targets)
            {
                <article class="scope @(t.IsApproved ? "approved" : "")">
                    <div class="scope-head">
                        <div>
                            <h3>@t.Name</h3>
                            @if (t.Description is not null) { <p class="muted small">@t.Description</p> }
                        </div>
                        @if (t.IsApproved)
                        {
                            <StatusPill Tone="ok">Zatwierdzony @Labels.Local(t.ApprovedAt)</StatusPill>
                        }
                        else
                        {
                            <StatusPill Tone="warn">Niezatwierdzony</StatusPill>
                        }
                    </div>
                    <div class="chips">
                        @foreach (var e in t.Includes) { <span class="chip mono">@e</span> }
                        @foreach (var e in t.Excludes) { <span class="chip chip-exclude mono" title="Wykluczenie">− @e</span> }
                        @if (t.AllowPublicAddresses) { <span class="chip chip-public">adresy publiczne dozwolone</span> }
                    </div>
                    <div class="muted small">Skany: @t.ScanCount @(t.LastScanAt is not null ? $"· ostatni {Labels.Local(t.LastScanAt)}" : "")</div>

                    @if (_approvingId == t.Id)
                    {
                        <div class="approval">
                            <p>Zatwierdzenie oznacza, że WELES może aktywnie łączyć się z każdym adresem z tego zakresu (wykrywanie hostów, porty, banery usług, TLS, HTTP). WELES nie wykonuje exploitów, prób logowania ani testów destrukcyjnych.</p>
                            <label class="checkbox"><input type="checkbox" @bind="_approvalConfirmed" /><span>Potwierdzam, że jestem właścicielem tych zasobów lub mam uprawnienie do ich audytu.</span></label>
                            <div class="actions">
                                <button class="btn btn-primary" disabled="@(!_approvalConfirmed || _busy)" @onclick="() => ApproveAsync(t.Id)">Zatwierdź zakres</button>
                                <button class="btn btn-ghost" @onclick="() => _approvingId = null">Anuluj</button>
                            </div>
                        </div>
                    }

                    <div class="actions">
                        @if (t.IsApproved)
                        {
                            <select class="input input-sm" @bind="_profiles[t.Id]">
                                <option value="@Weles.Core.Networking.PortSpecification.Quick">Szybki (@Weles.Core.Networking.PortSpecification.QuickPorts.Count portów)</option>
                                <option value="@Weles.Core.Networking.PortSpecification.Standard">Standardowy (@Weles.Core.Networking.PortSpecification.StandardPorts.Distinct().Count() portów)</option>
                                <option value="@Weles.Core.Networking.PortSpecification.Mobile">Urządzenia mobilne (szybki + ADB, udostępnianie plików, KDE Connect…)</option>
                                <option value="custom">Własna lista portów…</option>
                            </select>
                            @if (_profiles[t.Id] == "custom")
                            {
                                <input class="input input-sm mono" placeholder="22,80,443,8000-8100" @bind="_customPorts[t.Id]" />
                            }
                            <button class="btn btn-primary btn-sm" disabled="@(t.HasActiveScan || _busy)" @onclick="() => StartAsync(t.Id)"><Icon Name="play" Size="14" /> @(t.HasActiveScan ? "Skan w toku" : "Uruchom skan")</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => RevokeAsync(t.Id)">Cofnij zatwierdzenie</button>
                        }
                        else if (_approvingId != t.Id)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => { _approvingId = t.Id; _approvalConfirmed = false; }"><Icon Name="check" Size="14" /> Zatwierdź…</button>
                        }
                        <button class="btn btn-ghost btn-sm" disabled="@t.HasActiveScan" @onclick="() => Edit(t)">Edytuj</button>
                        <button class="btn btn-ghost btn-sm" disabled="@(t.ScanCount > 0)" title="@(t.ScanCount > 0 ? "Zakres ma historię skanów" : "")" @onclick="() => DeleteAsync(t.Id)">Usuń</button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private sealed class EditorModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string Include { get; set; } = "";
        public string? Exclude { get; set; }
        public bool AllowPublic { get; set; }
        public ScanTargetInput ToInput() => new(Name, Description, Include, Exclude, AllowPublic);
    }

    private IReadOnlyList<LocalInterfaceInfo> _interfaces = [];
    private IReadOnlyList<ScanTargetSummary>? _targets;
    private EditorModel? _editor;
    private int? _editingId;
    private List<string> _editorErrors = [];
    private ScopePreview? _preview;
    private int? _approvingId;
    private bool _approvalConfirmed;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private readonly Dictionary<int, string> _profiles = [];
    private readonly Dictionary<int, string> _customPorts = [];

    protected override async Task OnInitializedAsync()
    {
        _interfaces = LocalNetwork.GetInterfaces();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _targets = await Targets.ListAsync();
        foreach (var t in _targets)
        {
            _profiles.TryAdd(t.Id, Weles.Core.Networking.PortSpecification.Quick);
            _customPorts.TryAdd(t.Id, "");
        }
    }

    private void NewScope() => OpenEditor(null, new EditorModel());

    private void ScopeFromInterface(LocalInterfaceInfo nic) =>
        OpenEditor(null, new EditorModel { Name = $"Sieć lokalna {nic.SuggestedScope}", Include = nic.SuggestedScope, Description = $"Interfejs {nic.Name}" });

    private void Edit(ScanTargetSummary t) =>
        OpenEditor(t.Id, new EditorModel { Name = t.Name, Description = t.Description, Include = string.Join('\n', t.Includes), Exclude = string.Join('\n', t.Excludes), AllowPublic = t.AllowPublicAddresses });

    private void OpenEditor(int? id, EditorModel model)
    {
        _editingId = id;
        _editor = model;
        _editorErrors = [];
        _preview = null;
    }

    private void CloseEditor() => _editor = null;

    private async Task PreviewAsync()
    {
        if (_editor is null) return;
        _busy = true;
        _preview = await Targets.PreviewAsync(_editor.ToInput());
        _editorErrors = [];
        _busy = false;
    }

    private async Task SaveAsync()
    {
        if (_editor is null) return;
        _busy = true;
        var result = _editingId is { } id ? await Targets.UpdateAsync(id, _editor.ToInput()) : await Targets.CreateAsync(_editor.ToInput());
        _busy = false;
        if (!result.Success)
        {
            _editorErrors = [.. result.Errors];
            return;
        }

        _editor = null;
        Show(_editingId is null ? "Zakres zapisany. Zatwierdź go, aby móc uruchomić skan." : "Zmiany zapisane – zakres wymaga ponownego zatwierdzenia.");
        await ReloadAsync();
    }

    private async Task ApproveAsync(int id)
    {
        _busy = true;
        var result = await Targets.ApproveAsync(id, _approvalConfirmed);
        _busy = false;
        _approvingId = null;
        Show(result.Success ? "Zakres zatwierdzony." : string.Join(" ", result.Errors), !result.Success);
        await ReloadAsync();
    }

    private async Task RevokeAsync(int id)
    {
        await Targets.RevokeApprovalAsync(id);
        Show("Zatwierdzenie cofnięte.");
        await ReloadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var result = await Targets.DeleteAsync(id);
        Show(result.Success ? "Zakres usunięty." : string.Join(" ", result.Errors), !result.Success);
        await ReloadAsync();
    }

    private async Task StartAsync(int id)
    {
        var spec = _profiles[id] == "custom" ? _customPorts[id] : _profiles[id];
        _busy = true;
        var result = await Targets.StartScanAsync(id, spec);
        _busy = false;
        if (result.Success)
        {
            Navigation.NavigateTo($"scans/{result.Id}");
            return;
        }

        Show(string.Join(" ", result.Errors), true);
    }

    private void Show(string message, bool isError = false)
    {
        _message = message;
        _messageIsError = isError;
    }
}
