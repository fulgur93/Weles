@page "/scans/{ScanId:int}"
@using Weles.Core.Entities
@using Weles.Infrastructure.Queries
@using Weles.Infrastructure.Scanning
@implements IAsyncDisposable
@inject ScanQueries Queries
@inject ScanCoordinator Coordinator
@inject ScanTargetService Targets

<PageTitle>Skan #@ScanId · WELES</PageTitle>

@if (_detail is null)
{
    <div class="card loading">@(_notFound ? "Skan nie istnieje." : "Wczytywanie…")</div>
}
else
{
    var s = _detail.Summary;
    <div class="page-header">
        <div>
            <a class="back-link" href="scans"><Icon Name="arrow-left" Size="14" /> Scans</a>
            <h1>Skan #@s.Id · @s.TargetName</h1>
            <p class="page-subtitle">Porty: <span class="mono">@s.PortSpecification</span> (@_detail.PortCount) · rozpoczęty @Labels.Local(s.StartedAt ?? s.CreatedAt) · czas @Labels.Duration(s.StartedAt, s.CompletedAt)</p>
        </div>
        <div class="header-actions">
            <ScanStatusPill Status="s.Status" />
            @if (IsActive)
            {
                <button class="btn btn-danger" disabled="@(_progress?.StopRequested == true)" @onclick="Stop">@(_progress?.StopRequested == true ? "Zatrzymywanie…" : "Zatrzymaj skan")</button>
            }
        </div>
    </div>

    @if (s.ErrorMessage is not null)
    {
        <div class="alert alert-bad">@s.ErrorMessage</div>
    }

    @if (IsActive && _progress is { } p)
    {
        <section class="card progress-card">
            <div class="progress-head">
                <strong>@Labels.Of(p.Phase)</strong>
                <span class="muted small">@p.Activity</span>
                <span class="progress-pct">@p.PercentComplete.ToString("0")%</span>
            </div>
            <div class="progress"><div class="progress-fill" style="width:@p.PercentComplete.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
            <div class="progress-stats">
                <span>Sprawdzone adresy <strong>@p.HostsProbed / @p.HostsTotal</strong></span>
                <span>Aktywne hosty <strong>@p.HostsAlive</strong></span>
                <span>Przeskanowane hosty <strong>@p.HostsCompleted</strong></span>
                <span>Otwarte porty <strong>@p.OpenPorts</strong></span>
                <span>Rozpoznane usługi <strong>@p.ServicesIdentified</strong></span>
            </div>
        </section>
    }

    <section class="kpi-grid kpi-grid-4">
        <div class="kpi card"><div class="kpi-label">Adresy w zakresie</div><div class="kpi-value">@s.HostsTargeted</div></div>
        <div class="kpi card"><div class="kpi-label">Aktywne hosty</div><div class="kpi-value">@_detail.Hosts.Count</div></div>
        <div class="kpi card"><div class="kpi-label">Otwarte porty</div><div class="kpi-value">@_detail.Hosts.Sum(h => h.Ports.Count)</div></div>
        <div class="kpi card"><div class="kpi-label">Rozpoznane usługi</div><div class="kpi-value">@_detail.Hosts.SelectMany(h => h.Ports).Count(p => p.Service is { DetectionMethod: not "port-hint" })</div><div class="kpi-hint">na podstawie odpowiedzi usługi, nie numeru portu</div></div>
    </section>

    <section class="card">
        <div class="card-title"><Icon Name="assets" /> Wykryte hosty</div>
        @if (_detail.Hosts.Count == 0)
        {
            <p class="muted">@(IsActive ? "Wyniki pojawią się po przeskanowaniu pierwszych hostów." : "Nie wykryto aktywnych hostów w tym zakresie.")</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead><tr><th>Adres IP</th><th>Nazwa hosta</th><th>MAC / producent</th><th>Typ / system</th><th>Wykryty przez</th><th>Otwarte porty</th></tr></thead>
                    <tbody>
                        @foreach (var h in _detail.Hosts)
                        {
                            var expanded = _expanded.Contains(h.Id);
                            <tr class="clickable @(expanded ? "expanded" : "")" @onclick="() => Toggle(h.Id)">
                                <td class="mono"><strong>@h.IpAddress</strong>@if (h.AssetId is { } assetId) { <a class="asset-link" href="assets/@assetId" title="Szczegóły urządzenia" @onclick:stopPropagation="true">↗</a> } @if (h.IsGateway) { <span class="tag">brama</span> }</td>
                                <td>@(h.Hostname ?? "—")</td>
                                <td><span class="mono small">@(h.MacAddress ?? "—")</span><div class="muted small">@h.Vendor</div></td>
                                <td title="@h.ClassificationReasons">@Labels.Of(h.AssetTypeGuess)<div class="muted small">@(h.OsGuess ?? "system nieznany")</div></td>
                                <td class="small">@Labels.Of(h.DiscoveryMethods)@if (h.RoundTripMs is { } rtt) { <div class="muted small">@rtt.ToString("0") ms@(h.Ttl is { } ttl ? $" · TTL {ttl}" : "")</div> }</td>
                                <td>
                                    <div class="chips">
                                        @foreach (var port in h.Ports.OrderBy(p => p.Port))
                                        {
                                            <span class="chip mono" title="@port.Service?.ServiceName">@port.Port</span>
                                        }
                                        @if (h.Ports.Count == 0) { <span class="muted small">brak</span> }
                                    </div>
                                </td>
                            </tr>
                            @if (expanded)
                            {
                                <tr class="detail-row">
                                    <td colspan="6">
                                        @if (!string.IsNullOrEmpty(h.ClassificationReasons))
                                        {
                                            <div class="reasons"><strong>Dlaczego @Labels.Of(h.AssetTypeGuess).ToLowerInvariant()?</strong> @string.Join(" · ", h.ClassificationReasons.Split('\n'))</div>
                                        }
                                        <AnnouncedServices Host="h" />
                                        <ServiceTable Ports="h.Ports" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="card-title"><Icon Name="clock" /> Dziennik skanu</div>
        <ul class="events">
            @foreach (var e in _detail.Events)
            {
                <li class="event event-@e.Level.ToString().ToLowerInvariant()"><span class="mono muted">@e.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span> @e.Message</li>
            }
        </ul>
    </section>
}

@code {
    [Parameter] public int ScanId { get; set; }

    private ScanDetail? _detail;
    private ScanProgress? _progress;
    private bool _notFound;
    private readonly HashSet<int> _expanded = [];
    private PeriodicTimer? _timer;
    private Task? _pollTask;
    private readonly CancellationTokenSource _cts = new();

    private bool IsActive => _detail?.Summary.Status is ScanStatus.Pending or ScanStatus.Running;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        if (IsActive && _timer is null)
        {
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _pollTask = PollAsync();
        }
    }

    private async Task LoadAsync()
    {
        _detail = await Queries.GetAsync(ScanId);
        _notFound = _detail is null;
        _progress = Coordinator.GetProgress(ScanId);
    }

    private async Task PollAsync()
    {
        var tick = 0;
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                _progress = Coordinator.GetProgress(ScanId);
                if (++tick % 3 == 0 || !Coordinator.IsActive(ScanId))
                {
                    await LoadAsync();
                }

                await InvokeAsync(StateHasChanged);
                if (!IsActive) break;
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Stop()
    {
        Targets.StopScan(ScanId);
        _progress = Coordinator.GetProgress(ScanId);
    }

    private void Toggle(int hostId)
    {
        if (!_expanded.Remove(hostId)) _expanded.Add(hostId);
    }


    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _timer?.Dispose();
        if (_pollTask is not null)
        {
            try { await _pollTask; } catch (OperationCanceledException) { }
        }

        _cts.Dispose();
    }
}
