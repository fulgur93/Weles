@page "/topology"
@using Weles.Infrastructure.Queries
@inject TopologyQueries Queries
@inject NetworkQueries Networks

<PageTitle>@L.T("Topologia sieci · WELES")</PageTitle>

<div class="page-header">
    <div>
        <h1>@L.T("Topologia sieci")</h1>
        <p class="page-subtitle">@L.T("Sieci, routery i urządzenia z kolorem ryzyka. Każde połączenie ma swój dowód: zaobserwowane (MAC w tablicy ARP – ten sam segment, TTL odpowiedzi – liczba routerów po drodze, traceroute – routery na trasie) albo tylko wywnioskowane z adresu i bramy. WELES nie przechwytuje ruchu sieciowego – obserwacje pochodzą z sond skanu. Kliknij urządzenie, aby zobaczyć szczegóły.")</p>
    </div>
</div>

@if (_model is null)
{
    <div class="card loading">@L.T("Wczytywanie…")</div>
}
else if (_model.Networks.Count == 0)
{
    <section class="card empty">
        @if (_networks is not null) { <div class="toolbar"><NetworkPicker Context="_networks" Value="@_filter" /></div> }
        @if (_filter == NetworkContext.Current && _networks?.Networks.Any(n => n.Devices > 0) == true)
        {
            <p>@L.T("W bieżącej sieci nie ma jeszcze urządzeń. W bazie są urządzenia z innych sieci lub zasoby publiczne – wybierz „Wszystkie sieci” albo konkretną sieć powyżej.")</p>
            <a class="btn btn-primary" href="topology?net=all">@L.T("Pokaż wszystkie sieci")</a>
        }
        else
        {
            <p>@L.T("Mapa pojawi się po pierwszym skanie.") <a href="discovery">@L.T("Wykrywanie sieci")</a></p>
        }
    </section>
}
else
{
    <section class="card">
        <div class="toolbar">
            @if (_networks is not null) { <NetworkPicker Context="_networks" Value="@_filter" /> }
            <label class="checkbox inline"><input type="checkbox" @bind="_onlyProblems" /><span>@L.T("Wyróżnij punkty ekspozycji")</span></label>
            <div class="topo-legend small muted">
                <span><span class="swatch risk-critical"></span>Critical</span>
                <span><span class="swatch risk-high"></span>High</span>
                <span><span class="swatch risk-medium"></span>Medium</span>
                <span><span class="swatch risk-low"></span>Low</span>
                <span><span class="swatch risk-info"></span>Informational</span>
                <span><span class="ring"></span>@L.T("punkt ekspozycji")</span>
                <span><span class="edge-solid"></span>@L.T("zaobserwowane")</span>
                <span><span class="edge-routed"></span>@L.T("przez routery (TTL/traceroute)")</span>
                <span><span class="edge-dashed"></span>@L.T("wywnioskowane")</span>
            </div>
        </div>
        @if (_filter == NetworkContext.Current && _model.HiddenOtherNetworks > 0)
        {
            <p class="muted small">@L.F("Bieżąca sieć: {0} · ukryto {1} {2} z innych sieci", _model.CurrentNetwork, _model.HiddenOtherNetworks, Labels.Devices(_model.HiddenOtherNetworks))</p>
        }
    </section>

    <section class="topology-layout">
        <div>
            @foreach (var network in _model.Networks)
            {
                <div class="card topo-card">
                    <div class="card-title"><Icon Name="topology" /> <span class="mono">@L.Message(network.Label)</span>
                        <span class="muted small">· @L.F("{0} {1}", network.Devices.Count + (network.Gateway is null ? 0 : 1), Labels.Devices(network.Devices.Count + (network.Gateway is null ? 0 : 1)))</span></div>
                    @if (!network.IsPublic && network.Devices.Count > 0)
                    {
                        <p class="muted small">@L.F("Połączenia: {0} zaobserwowanych ({1}), {2} wywnioskowanych z adresu i bramy.", network.ObservedLinks, EvidenceBreakdown(network), network.InferredLinks)
                            @if (network.Routers is { Count: > 0 } routers) { <br />@L.T("Routery na trasie (traceroute):") <span class="mono">@string.Join(", ", routers.OrderByDescending(r => r.Value).Select(r => $"{r.Key} ({r.Value})"))</span> }</p>
                    }
                    <TopologyMap Network="network" SelectedAssetId="_selected?.AssetId" OnlyProblems="_onlyProblems" OnSelect="n => _selected = n" />
                </div>
            }
        </div>

        <aside class="card topo-details">
            @if (_selected is { } n)
            {
                <div class="card-title"><Icon Name="assets" /> @L.Message(n.Name)</div>
                <dl class="facts">
                    <dt>@L.T("Adres IP")</dt><dd class="mono">@n.Ip</dd>
                    @if (n.Hostname is not null) { <dt>@L.T("Nazwa hosta")</dt><dd>@n.Hostname</dd> }
                    <dt>@L.T("Typ")</dt><dd>@Labels.Of(n.Type)@(n.IsGateway ? " · " + L.T("brama sieci") : "")</dd>
                    <dt>@L.T("Status")</dt><dd>@Labels.Of(n.Status)</dd>
                    <dt>@L.T("Ryzyko")</dt><dd>@if (n.RiskScore is { } s) { <StatusPill Tone="@Labels.Tone(n.RiskLevel)">@s.ToString("0") · @(n.RiskLevel is { } l ? Labels.Of(l) : "")</StatusPill> } else { <span class="muted">—</span> }</dd>
                    <dt>@L.T("Otwarte porty")</dt><dd class="mono">@(n.OpenPorts.Count == 0 ? "—" : string.Join(", ", n.OpenPorts))</dd>
                    @if (n.Products.Count > 0) { <dt>@L.T("Oprogramowanie")</dt><dd>@string.Join(", ", n.Products)</dd> }
                    <dt>@L.T("Połączenie")</dt>
                    <dd>@if (n.Link is { } link) { <StatusPill Tone="@(link.Observed ? "ok" : "muted")">@(link.Observed ? L.T("zaobserwowane") : L.T("wywnioskowane"))</StatusPill> <span class="small">@L.Message(link.Reason)</span> } else { <span class="muted">—</span> }</dd>
                </dl>
                @if (n.Exposure.Count > 0)
                {
                    <div class="subtitle">@L.T("Punkty ekspozycji")</div>
                    <ul class="reasons-list">@foreach (var e in n.Exposure) { <li>@L.Message(e)</li> }</ul>
                }
                <div class="actions">
                    <a class="btn btn-primary btn-sm" href="assets/@n.AssetId">@L.T("Szczegóły urządzenia")</a>
                    <a class="btn btn-ghost btn-sm" href="ai?asset=@n.AssetId"><Icon Name="ai" Size="14" /> @L.T("Zapytaj Analityka AI")</a>
                </div>
            }
            else
            {
                <p class="muted">@L.T("Kliknij urządzenie na mapie.")</p>
                <p class="muted small">@L.T("Przerywana linia do Internetu oznacza, że dostępności z Internetu nie badano. Przerywany pierścień oznacza urządzenie z problemem co najmniej średniej wagi lub podatnością z CISA KEV.")</p>
                <a class="btn btn-ghost btn-sm" href="attack-paths"><Icon Name="paths" Size="14" /> @L.T("Ścieżki ataku")</a>
            }
        </aside>
    </section>
}

@code {
    private TopologyModel? _model;
    private TopologyNode? _selected;
    [SupplyParameterFromQuery(Name = "net")] public string? NetworkParameter { get; set; }

    private NetworkContext? _networks;
    private string _filter = NetworkContext.All;
    private bool _onlyProblems;

    private static string EvidenceBreakdown(TopologyNetwork network)
    {
        var kinds = network.Devices.Where(d => d.Link?.Observed == true).GroupBy(d => d.Link!.Kind).OrderBy(g => g.Key)
            .Select(g => $"{g.Key switch
            {
                Weles.Core.Topology.LinkKind.ArpNeighbour => "ARP",
                Weles.Core.Topology.LinkKind.TtlDirect or Weles.Core.Topology.LinkKind.TtlRouted => "TTL",
                _ => "traceroute"
            }} {g.Count()}");
        var text = string.Join(", ", kinds);
        return text.Length == 0 ? "—" : text;
    }

    protected override async Task OnParametersSetAsync()
    {
        _networks = await Networks.ContextAsync();
        _filter = _networks.Normalize(NetworkParameter);
        var networks = _networks;
        var filter = _filter;
        _model = await Queries.GetAsync(filter == NetworkContext.Current,
            filter is NetworkContext.All or NetworkContext.Current ? null : id => networks.IncludesAsset(filter, id));
        _selected = null;
    }
}
