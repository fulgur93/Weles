@page "/discovery"
@using Weles.Infrastructure.Discovery
@using Weles.Infrastructure.Scanning
@inject LocalNetworkDiscovery LocalNetwork
@inject ScanTargetService Targets
@inject NavigationManager Navigation

<PageTitle>@L.T("Wykrywanie sieci · WELES")</PageTitle>

<div class="page-header">
    <div>
        <h1>@L.T("Wykrywanie sieci")</h1>
        <p class="page-subtitle">@L.T("Zdefiniuj i zatwierdź zakres, a potem uruchom wykrywanie urządzeń, portów i usług. WELES skanuje wyłącznie zatwierdzone zakresy.")</p>
    </div>
    <button class="btn btn-primary" @onclick="NewScope"><Icon Name="layers" Size="16" /> @L.T("Nowy zakres")</button>
</div>

<section class="card">
    <div class="card-title"><Icon Name="discovery" /> @L.T("Sieci tego komputera")</div>
    @if (_interfaces.Count == 0)
    {
        <p class="muted">@L.T("Nie wykryto aktywnych interfejsów IPv4 (poza loopback).")</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>@L.T("Interfejs")</th><th>@L.T("Adres")</th><th>@L.T("Sieć")</th><th>@L.T("Brama")</th><th>@L.T("MAC / producent")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var nic in _interfaces)
                    {
                        <tr>
                            <td><strong>@nic.Name</strong><div class="muted small">@nic.Type</div></td>
                            <td class="mono">@nic.Address/@nic.PrefixLength</td>
                            <td class="mono">@nic.NetworkCidr<div class="muted small">@L.F("{0} adresów", nic.HostCount)</div></td>
                            <td class="mono">@(nic.Gateway ?? "—")</td>
                            <td><span class="mono">@(nic.MacAddress ?? "—")</span><div class="muted small">@nic.Vendor</div></td>
                            <td class="right">
                                <button class="btn btn-ghost btn-sm" @onclick="() => ScopeFromInterface(nic)">@L.F("Utwórz zakres {0}", nic.SuggestedScope)</button>
                                @if (nic.Note is not null) { <div class="muted small">@L.Message(nic.Note)</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (_editor is not null)
{
    <section class="card editor">
        <div class="card-title"><Icon Name="layers" /> @(_editingId is null ? L.T("Nowy zakres skanowania") : L.T("Edycja zakresu"))</div>
        @if (_editingId is not null)
        {
            <div class="alert alert-warn"><Icon Name="alert" Size="15" /> @L.T("Zapisanie zmian cofa zatwierdzenie zakresu – trzeba go zatwierdzić ponownie.")</div>
        }
        <div class="form-grid">
            <label class="field"><span>@L.T("Nazwa")</span><input class="input" @bind="_editor.Name" maxlength="200" placeholder="@L.T("np. Biuro – LAN")" /></label>
            <label class="field"><span>@L.T("Opis (opcjonalnie)")</span><input class="input" @bind="_editor.Description" maxlength="2000" /></label>
            <label class="field">
                <span>@L.T("Adresy do skanowania")</span>
                <textarea class="input mono" rows="5" @bind="_editor.Include" placeholder="192.168.1.0/24&#10;10.0.0.10-10.0.0.50&#10;nas.firma.local"></textarea>
                <small class="muted">@L.T("IP, CIDR (maks. /16), zakres") <code>@L.T("a.b.c.d-e")</code> @L.T("lub domena – jeden wpis w wierszu.")</small>
            </label>
            <label class="field">
                <span>@L.T("Wykluczenia")</span>
                <textarea class="input mono" rows="5" @bind="_editor.Exclude" placeholder="192.168.1.1&#10;192.168.1.200-254"></textarea>
                <small class="muted">@L.T("Wykluczenia mają pierwszeństwo przed listą adresów.")</small>
            </label>
        </div>
        <label class="checkbox">
            <input type="checkbox" @bind="_editor.AllowPublic" />
            <span>@L.T("Zezwól na adresy publiczne (Internet) –") <strong>@L.T("tylko jeśli masz pisemne uprawnienie do ich testowania")</strong></span>
        </label>

        @if (_editorErrors.Count > 0)
        {
            <div class="alert alert-bad"><ul>@foreach (var e in _editorErrors) { <li>@L.Message(e)</li> }</ul></div>
        }
        @if (_preview is not null)
        {
            <div class="alert @(_preview.Errors.Count > 0 ? "alert-bad" : "alert-info")">
                @if (_preview.Errors.Count > 0)
                {
                    <ul>@foreach (var e in _preview.Errors) { <li>@L.Message(e)</li> }</ul>
                }
                else
                {
                    <div><strong>@_preview.AddressCount</strong> @L.T("adresów do sprawdzenia, np.") <span class="mono">@string.Join(", ", _preview.Sample)</span>@(_preview.AddressCount > _preview.Sample.Count ? "…" : "")</div>
                }
                @foreach (var w in _preview.Warnings) { <div class="small">⚠ @L.Message(w)</div> }
            </div>
        }

        <div class="actions">
            <button class="btn btn-ghost" @onclick="PreviewAsync" disabled="@_busy"><Icon Name="monitoring" Size="15" /> @L.T("Podgląd zakresu")</button>
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">@L.T("Zapisz")</button>
            <button class="btn btn-ghost" @onclick="CloseEditor">@L.T("Anuluj")</button>
        </div>
    </section>
}

<section class="card">
    <div class="card-title"><Icon Name="lock" /> @L.T("Zakresy skanowania")</div>
    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert-bad" : "alert-ok")">@_message</div>
    }
    @if (_targets is null)
    {
        <p class="muted">@L.T("Wczytywanie…")</p>
    }
    else if (_targets.Count == 0)
    {
        <div class="empty">
            <p>@L.T("Brak zdefiniowanych zakresów. Utwórz zakres z wykrytej sieci powyżej albo dodaj własny.")</p>
        </div>
    }
    else
    {
        <div class="scope-list">
            @foreach (var t in _targets)
            {
                <article class="scope @(t.IsApproved ? "approved" : "")">
                    <div class="scope-head">
                        <div>
                            <h3>@L.Message(t.Name)</h3>
                            @if (t.Description is not null) { <p class="muted small">@L.Message(t.Description)</p> }
                        </div>
                        @if (t.IsApproved)
                        {
                            <StatusPill Tone="ok">@L.F("Zatwierdzony {0}", Labels.Local(t.ApprovedAt))</StatusPill>
                        }
                        else
                        {
                            <StatusPill Tone="warn">@L.T("Niezatwierdzony")</StatusPill>
                        }
                    </div>
                    <div class="chips">
                        @foreach (var e in t.Includes) { <span class="chip mono">@e</span> }
                        @foreach (var e in t.Excludes) { <span class="chip chip-exclude mono" title="@L.T("Wykluczenie")">− @e</span> }
                        @if (t.AllowPublicAddresses) { <span class="chip chip-public">@L.T("adresy publiczne dozwolone")</span> }
                    </div>
                    <div class="muted small">@L.T("Skany:") @t.ScanCount @(t.LastScanAt is not null ? "· " + L.F("ostatni {0}", Labels.Local(t.LastScanAt)) : "")</div>

                    @if (_approvingId == t.Id)
                    {
                        <div class="approval">
                            <p>@L.T("Zatwierdzenie oznacza, że WELES może aktywnie łączyć się z każdym adresem z tego zakresu (wykrywanie hostów, porty, banery usług, TLS, HTTP). WELES nie wykonuje exploitów, prób logowania ani testów destrukcyjnych.")</p>
                            <label class="checkbox"><input type="checkbox" @bind="_approvalConfirmed" /><span>@L.T("Potwierdzam, że jestem właścicielem tych zasobów lub mam uprawnienie do ich audytu.")</span></label>
                            <div class="actions">
                                <button class="btn btn-primary" disabled="@(!_approvalConfirmed || _busy)" @onclick="() => ApproveAsync(t.Id)">@L.T("Zatwierdź zakres")</button>
                                <button class="btn btn-ghost" @onclick="() => _approvingId = null">@L.T("Anuluj")</button>
                            </div>
                        </div>
                    }

                    <div class="actions">
                        @if (t.IsApproved)
                        {
                            <select class="input input-sm" @bind="_profiles[t.Id]">
                                <option value="@Weles.Core.Networking.PortSpecification.Quick">@L.F("Szybki ({0} portów)", Weles.Core.Networking.PortSpecification.QuickPorts.Count)</option>
                                <option value="@Weles.Core.Networking.PortSpecification.Standard">@L.F("Standardowy ({0} portów)", Weles.Core.Networking.PortSpecification.StandardPorts.Distinct().Count())</option>
                                <option value="@Weles.Core.Networking.PortSpecification.Mobile">@L.T("Urządzenia mobilne (szybki + ADB, udostępnianie plików, KDE Connect…)")</option>
                                <option value="custom">@L.T("Własna lista portów…")</option>
                            </select>
                            @if (_profiles[t.Id] == "custom")
                            {
                                <input class="input input-sm mono" placeholder="22,80,443,8000-8100" @bind="_customPorts[t.Id]" />
                            }
                            <button class="btn btn-primary btn-sm" disabled="@(t.HasActiveScan || _busy)" @onclick="() => StartAsync(t.Id)"><Icon Name="play" Size="14" /> @(t.HasActiveScan ? L.T("Skan w toku") : L.T("Uruchom skan"))</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => RevokeAsync(t.Id)">@L.T("Cofnij zatwierdzenie")</button>
                        }
                        else if (_approvingId != t.Id)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => { _approvingId = t.Id; _approvalConfirmed = false; }"><Icon Name="check" Size="14" /> @L.T("Zatwierdź…")</button>
                        }
                        <button class="btn btn-ghost btn-sm" disabled="@t.HasActiveScan" @onclick="() => Edit(t)">@L.T("Edytuj")</button>
                        <button class="btn btn-ghost btn-sm" disabled="@(t.ScanCount > 0)" title="@(t.ScanCount > 0 ? L.T("Zakres ma historię skanów") : "")" @onclick="() => DeleteAsync(t.Id)">@L.T("Usuń")</button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private sealed class EditorModel
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string Include { get; set; } = "";
        public string? Exclude { get; set; }
        public bool AllowPublic { get; set; }
        public ScanTargetInput ToInput() => new(Name, Description, Include, Exclude, AllowPublic);
    }

    private IReadOnlyList<LocalInterfaceInfo> _interfaces = [];
    private IReadOnlyList<ScanTargetSummary>? _targets;
    private EditorModel? _editor;
    private int? _editingId;
    private List<string> _editorErrors = [];
    private ScopePreview? _preview;
    private int? _approvingId;
    private bool _approvalConfirmed;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private readonly Dictionary<int, string> _profiles = [];
    private readonly Dictionary<int, string> _customPorts = [];

    protected override async Task OnInitializedAsync()
    {
        _interfaces = LocalNetwork.GetInterfaces();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _targets = await Targets.ListAsync();
        foreach (var t in _targets)
        {
            _profiles.TryAdd(t.Id, Weles.Core.Networking.PortSpecification.Quick);
            _customPorts.TryAdd(t.Id, "");
        }
    }

    private void NewScope() => OpenEditor(null, new EditorModel());

    private void ScopeFromInterface(LocalInterfaceInfo nic) =>
        OpenEditor(null, new EditorModel { Name = L.F("Sieć lokalna {0}", nic.SuggestedScope), Include = nic.SuggestedScope, Description = L.F("Interfejs {0}", nic.Name) });

    private void Edit(ScanTargetSummary t) =>
        OpenEditor(t.Id, new EditorModel { Name = t.Name, Description = t.Description, Include = string.Join('\n', t.Includes), Exclude = string.Join('\n', t.Excludes), AllowPublic = t.AllowPublicAddresses });

    private void OpenEditor(int? id, EditorModel model)
    {
        _editingId = id;
        _editor = model;
        _editorErrors = [];
        _preview = null;
    }

    private void CloseEditor() => _editor = null;

    private async Task PreviewAsync()
    {
        if (_editor is null) return;
        _busy = true;
        _preview = await Targets.PreviewAsync(_editor.ToInput());
        _editorErrors = [];
        _busy = false;
    }

    private async Task SaveAsync()
    {
        if (_editor is null) return;
        _busy = true;
        var result = _editingId is { } id ? await Targets.UpdateAsync(id, _editor.ToInput()) : await Targets.CreateAsync(_editor.ToInput());
        _busy = false;
        if (!result.Success)
        {
            _editorErrors = [.. result.Errors];
            return;
        }

        _editor = null;
        Show(_editingId is null ? L.T("Zakres zapisany. Zatwierdź go, aby móc uruchomić skan.") : L.T("Zmiany zapisane – zakres wymaga ponownego zatwierdzenia."));
        await ReloadAsync();
    }

    private async Task ApproveAsync(int id)
    {
        _busy = true;
        var result = await Targets.ApproveAsync(id, _approvalConfirmed);
        _busy = false;
        _approvingId = null;
        Show(result.Success ? L.T("Zakres zatwierdzony.") : string.Join(" ", result.Errors.Select(L.Message)), !result.Success);
        await ReloadAsync();
    }

    private async Task RevokeAsync(int id)
    {
        await Targets.RevokeApprovalAsync(id);
        Show(L.T("Zatwierdzenie cofnięte."));
        await ReloadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var result = await Targets.DeleteAsync(id);
        Show(result.Success ? L.T("Zakres usunięty.") : string.Join(" ", result.Errors.Select(L.Message)), !result.Success);
        await ReloadAsync();
    }

    private async Task StartAsync(int id)
    {
        var spec = _profiles[id] == "custom" ? _customPorts[id] : _profiles[id];
        _busy = true;
        var result = await Targets.StartScanAsync(id, spec);
        _busy = false;
        if (result.Success)
        {
            Navigation.NavigateTo($"scans/{result.Id}");
            return;
        }

        Show(string.Join(" ", result.Errors.Select(L.Message)), true);
    }

    private void Show(string message, bool isError = false)
    {
        _message = message;
        _messageIsError = isError;
    }
}
