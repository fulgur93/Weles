@page "/attack-paths"
@using Weles.Core.Risk
@using Weles.Infrastructure.Queries
@inject TopologyQueries Queries

<PageTitle>@L.T("Ścieżki ataku · WELES")</PageTitle>

<div class="page-header">
    <div>
        <h1>@L.T("Ścieżki ataku")</h1>
        <p class="page-subtitle">@L.T("Możliwe drogi dotarcia do urządzeń na podstawie wykrytych usług, problemów i roli urządzeń. To hipotezy, nie potwierdzone ataki – sama możliwość połączenia nie oznacza możliwości przejęcia, a WELES niczego nie próbuje wykorzystać.")</p>
    </div>
    <a class="btn btn-ghost" href="topology"><Icon Name="topology" Size="15" /> @L.T("Topologia sieci")</a>
</div>

@if (_paths is null)
{
    <div class="card loading">@L.T("Wczytywanie…")</div>
}
else if (_paths.Count == 0)
{
    <section class="card empty"><p>@L.T("Brak ścieżek: żadne urządzenie nie ma problemu co najmniej średniej wagi w ostatnich skanach.")</p></section>
}
else
{
    <div class="alert alert-info small">@L.T("Pewność ścieżki = iloczyn pewności kroków opartych na dowodach (osiągalność usługi, słabość). Punkt startowy to założenie, a skutek – hipoteza wynikająca z roli urządzenia.")</div>
    @foreach (var (path, i) in _paths.Select((p, i) => (p, i)))
    {
        <section class="card attack-path">
            <div class="card-title">
                <span class="priority-rank">@(i + 1)</span>
                <StatusPill Tone="@Labels.Tone(path.Level)">@path.Priority.ToString("0")</StatusPill>
                <span>@L.Message(path.Title)</span>
                <span class="muted small" style="margin-left:auto">@L.F("pewność ścieżki {0}%", path.Confidence) · <strong>@L.T("hipoteza")</strong></span>
            </div>
            <ol class="path-steps">
                @foreach (var step in path.Steps)
                {
                    <li class="path-step @step.Kind.ToString().ToLowerInvariant()">
                        <div class="path-head">
                            <span class="path-kind">@KindLabel(step.Kind)</span>
                            <strong>@L.Message(step.Title)</strong>
                            <span class="muted small">@(step.Confidence is { } c ? L.F("pewność {0}%", c) : L.T("założenie"))</span>
                        </div>
                        <div class="small muted">@L.Message(step.Justification)</div>
                        @if (step.CveId is { } cve) { <a class="small mono" href="vulnerabilities/@cve">@cve</a> }
                    </li>
                }
            </ol>
            <div class="actions">
                <a class="btn btn-ghost btn-sm" href="assets/@path.TargetAssetId">@L.T("Szczegóły urządzenia")</a>
                <a class="btn btn-ghost btn-sm" href="ai?asset=@path.TargetAssetId"><Icon Name="ai" Size="14" /> @L.T("Zapytaj Analityka AI")</a>
            </div>
        </section>
    }
}

@code {
    private IReadOnlyList<AttackPath>? _paths;

    protected override async Task OnInitializedAsync() => _paths = await Queries.AttackPathsAsync();

    private string KindLabel(PathStepKind kind) => kind switch
    {
        PathStepKind.Entry => L.T("start"),
        PathStepKind.Access => L.T("dostęp"),
        PathStepKind.Weakness => L.T("słabość"),
        _ => L.T("skutek")
    };
}
