@page "/scans"
@using Weles.Infrastructure.Queries
@using Weles.Infrastructure.Import
@using Weles.Infrastructure.Scanning
@inject ScanQueries Queries
@inject ScanImportService Importer
@inject ScanTargetService Targets

<PageTitle>@L.T("Skany · WELES")</PageTitle>

<div class="page-header">
    <div>
        <h1>@L.T("Skany")</h1>
        <p class="page-subtitle">@L.T("Historia skanowań. Wyniki każdego skanu są zachowywane i nie są nadpisywane.")</p>
    </div>
    <a class="btn btn-primary" href="discovery"><Icon Name="play" Size="16" /> @L.T("Nowy skan")</a>
</div>

<section class="card">
    @if (_scans is null)
    {
        <p class="muted">@L.T("Wczytywanie…")</p>
    }
    else if (_scans.Count == 0)
    {
        <div class="empty"><p>@L.T("Nie wykonano jeszcze żadnego skanu. Zdefiniuj i zatwierdź zakres w") <a href="discovery">@L.T("Wykrywanie sieci")</a>.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table table-hover">
                <thead><tr><th>#</th><th>@L.T("Zakres")</th><th>@L.T("Status")</th><th>@L.T("Porty")</th><th>@L.T("Rozpoczęty")</th><th>@L.T("Czas")</th><th class="right">@L.T("Adresy")</th><th class="right">@L.T("Hosty")</th><th class="right">@L.T("Otwarte porty")</th></tr></thead>
                <tbody>
                    @foreach (var s in _scans)
                    {
                        <tr class="clickable" @onclick="@(() => Navigation.NavigateTo($"scans/{s.Id}"))">
                            <td class="mono">@s.Id</td>
                            <td><strong>@L.Message(s.TargetName)</strong></td>
                            <td><ScanStatusPill Status="s.Status" /></td>
                            <td class="mono small">@s.PortSpecification</td>
                            <td>@Labels.Local(s.StartedAt ?? s.CreatedAt)</td>
                            <td>@Labels.Duration(s.StartedAt, s.CompletedAt)</td>
                            <td class="right">@s.HostsTargeted</td>
                            <td class="right">@s.HostsAlive</td>
                            <td class="right">@s.OpenPorts</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <div class="card-title"><Icon Name="folder" /> @L.T("Import i eksport wyników")</div>
    <p class="muted small">@L.T("Wczytaj wyniki skanu z innego narzędzia: nmap XML (nmap -oX), CSV (kolumny ip, port, protocol, service, product, version, cpe, banner, hostname, mac) albo JSON (format eksportu WELES). Wyniki trafiają do historii jak zwykły skan – działają porównania, podatności, ryzyko i raporty. WELES nie wysyła przy tym żadnego ruchu.")</p>
    <div class="actions">
        <Can Policy="@Policies.Manage">
        <select class="input input-sm" @bind="_importScope">
            <option value="0">@L.T("Nowy zakres z adresów z pliku")</option>
            @foreach (var t in _scopes) { <option value="@t.Id">@L.Message(t.Name)</option> }
        </select>
        <label class="btn btn-primary btn-sm"><Icon Name="folder" Size="14" /> @(_importing ? L.T("Importowanie…") : L.T("Wybierz plik wyników"))
            <InputFile OnChange="ImportAsync" accept=".xml,.csv,.json" class="visually-hidden" disabled="@_importing" /></label>
        </Can>
        <a class="btn btn-ghost btn-sm" href="api/export/results.csv" download><Icon Name="download" Size="14" /> @L.T("Eksport CSV (najnowszy stan)")</a>
        <a class="btn btn-ghost btn-sm" href="api/export/results.json" download><Icon Name="download" Size="14" /> @L.T("Eksport JSON (najnowszy stan)")</a>
    </div>
    @if (_importError is not null) { <div class="alert alert-bad">@L.Message(_importError)</div> }
    @if (_imported is { } r)
    {
        <div class="alert alert-ok">@L.F("Zaimportowano ({0}): {1} hostów, {2} otwartych portów.", r.Format, r.Hosts, r.Ports) <a href="scans/@r.ScanId">@L.F("Skan #{0}", r.ScanId)</a>
            @foreach (var w in r.Warnings.Take(5)) { <div class="small">@L.Message(w)</div> }</div>
    }
</section>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    private IReadOnlyList<ScanListItem>? _scans;
    private IReadOnlyList<ScanTargetSummary> _scopes = [];
    private int _importScope;
    private bool _importing;
    private string? _importError;
    private ScanImportResult? _imported;

    protected override async Task OnInitializedAsync()
    {
        _scans = await Queries.ListAsync();
        _scopes = await Targets.ListAsync();
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        _importing = true;
        _importError = null;
        _imported = null;
        try
        {
            await using var stream = e.File.OpenReadStream(ScanImportService.MaxFileBytes);
            _imported = await Importer.ImportAsync(stream, e.File.Name, _importScope == 0 ? null : _importScope);
            _scans = await Queries.ListAsync();
            _scopes = await Targets.ListAsync();
        }
        catch (ScanImportException ex)
        {
            _importError = ex.Message;
        }
        catch (IOException)
        {
            _importError = "Plik jest większy niż 50 MB lub nie da się go odczytać.";
        }
        finally
        {
            _importing = false;
        }
    }
}
