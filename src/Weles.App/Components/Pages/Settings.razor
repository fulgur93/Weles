@page "/settings"
@inject RuntimeInfo Runtime
@inject Weles.Infrastructure.Platform.WelesPaths Paths
@inject Weles.Infrastructure.Database.DatabaseInfoService DatabaseInfo
@inject IAiService Ai
@inject ThemeState ThemeState
@inject Autostart Autostart
@inject Weles.Infrastructure.AI.OllamaProcessHost EngineHost
@inject Microsoft.Extensions.Options.IOptions<Weles.Infrastructure.AI.AiOptions> AiOptions
@inject PanelLanState Lan
@inject Weles.Infrastructure.Agents.AgentListenerState AgentListener

<PageTitle>@L.T("Ustawienia · WELES")</PageTitle>

<div class="page-header">
    <div>
        <h1>@L.T("Ustawienia")</h1>
        <p class="page-subtitle">@L.T("Konfiguracja i stan lokalnej instalacji WELES.")</p>
    </div>
</div>

<section class="grid-2">
    <div class="card">
        <div class="card-title"><Icon Name="info" /> @L.T("Aplikacja")</div>
        <dl class="facts">
            <dt>@L.T("Wersja")</dt><dd>@Runtime.Version</dd>
            <dt>@L.T("Tryb")</dt><dd>@(Runtime.DemoMode ? L.T("Demonstracyjny (osobna baza)") : L.T("Produkcyjny"))</dd>
            <dt>@L.T("Adres panelu")</dt><dd class="mono">@Runtime.BaseUrl</dd>
            <dt>@L.T("Dostęp")</dt><dd>@(Lan.IsListening ? L.F("localhost oraz sieć lokalna {0} ({1}), logowanie kontem WELES", Lan.Url, Lan.Subnet ?? "") : L.T("tylko localhost, sesja chroniona tokenem uruchomieniowym"))</dd>
            <dt>@L.T("Uruchomiono")</dt><dd>@Runtime.StartedAt.ToLocalTime().ToString("g")</dd>
            <dt>@L.T("Środowisko")</dt><dd>@Runtime.Framework</dd>
            <dt>@L.T("System")</dt><dd>@Runtime.OperatingSystem (@Runtime.Architecture)</dd>
        </dl>
    </div>

    <div class="card">
        <div class="card-title"><Icon Name="sun" /> @L.T("Wygląd")</div>
        <div class="segmented" role="radiogroup" aria-label="@L.T("Motyw")">
            <button class="@(ThemeState.IsDark ? "active" : "")" @onclick="@(() => ThemeState.SetAsync(ThemeState.Dark))"><Icon Name="moon" Size="15" /> @L.T("Ciemny")</button>
            <button class="@(!ThemeState.IsDark ? "active" : "")" @onclick="@(() => ThemeState.SetAsync(ThemeState.Light))"><Icon Name="sun" Size="15" /> @L.T("Jasny")</button>
        </div>
        <p class="muted small">@L.T("Wybór jest zapisywany w lokalnej bazie.")</p>

        <div class="card-title" style="margin-top:18px"><Icon Name="surface" /> @L.T("Język")</div>
        <LanguageSwitch />
        <p class="muted small">@L.T("Język interfejsu, komunikatów i uzasadnień generowanych przez WELES. Opisy CVE pochodzą z NVD i są po angielsku.")</p>

        @if (Autostart.IsSupported && _isAdmin)
        {
            <div class="card-title" style="margin-top:18px"><Icon Name="play" /> @L.T("Uruchamianie")</div>
            <label class="checkbox"><input type="checkbox" checked="@_autostart" @onchange="ToggleAutostart" /> @L.T("Uruchamiaj WELES po zalogowaniu (w tle, bez otwierania przeglądarki)")</label>
            <p class="muted small">@L.T("Tylko dla bieżącego użytkownika, bez uprawnień administratora. Panel otworzysz skrótem WELES – trafi do działającej aplikacji.")</p>
            @if (_autostartError is not null) { <div class="alert alert-bad">@_autostartError</div> }
        }
    </div>

    @if (_isAdmin)
    {
        <div class="card">
            <div class="card-title"><Icon Name="lock" /> @L.T("Dostęp z sieci lokalnej")</div>
            <p class="muted small">@L.T("Domyślnie panel działa tylko na 127.0.0.1. Po włączeniu jest też dostępny przez HTTPS pod jednym prywatnym adresem tego komputera – tylko dla komputerów z tej samej podsieci i tylko po zalogowaniu kontem WELES (role: administrator, edytor, operator, przeglądający). Pierwsze konto administratora tworzy się wyłącznie lokalnie. Certyfikat jest samopodpisany – porównaj odcisk poniżej z ostrzeżeniem przeglądarki.")</p>
            <label class="checkbox"><input type="checkbox" @bind="_lanEnabled" /> @L.T("Udostępnij panel w sieci lokalnej")</label>
            <div class="toolbar">
                <select class="input" @bind="_lanAddress" aria-label="@L.T("Adres")">
                    <option value="">@L.T("— wybierz adres —")</option>
                    @foreach (var a in _lanAddresses) { <option value="@a.Address">@a.Label</option> }
                </select>
                <input class="input input-sm" type="number" min="1024" max="65535" @bind="_lanPort" aria-label="@L.T("Port")" />
                <button class="btn btn-primary btn-sm" @onclick="SaveLan">@L.T("Zapisz")</button>
            </div>
            @if (_lanMessage is not null) { <div class="small @(_lanError ? "tone-bad" : "tone-ok")">@L.Message(_lanMessage)</div> }
            <dl class="facts">
                <dt>@L.T("Stan")</dt>
                <dd>@(Lan.IsListening ? L.F("działa: {0} (klienci z {1})", Lan.Url, Lan.Subnet ?? "") : Lan.Active.Enabled ? L.F("nie uruchomiono: {0}", L.Message(Lan.Error ?? "")) : L.T("wyłączony"))</dd>
                @if (Lan.CertificateSha256 is { } fp) { <dt>@L.T("Odcisk SHA-256")</dt><dd class="mono small break">@fp</dd> }
            </dl>
        </div>
    }

    <div class="card">
        <div class="card-title"><Icon Name="database" /> @L.T("Baza danych")</div>
        @if (_db is null)
        {
            <p class="muted">@L.T("Wczytywanie…")</p>
        }
        else
        {
            <dl class="facts">
                <dt>@L.T("Plik")</dt><dd class="mono break">@_db.FilePath</dd>
                <dt>@L.T("Rozmiar")</dt><dd>@Format.Bytes(_db.SizeBytes)</dd>
                <dt>@L.T("SQLite")</dt><dd>@_db.SqliteVersion</dd>
                <dt>@L.T("Migracje")</dt>
                <dd>
                    @L.F("{0} zastosowanych", _db.AppliedMigrations.Count)
                    @if (_db.PendingMigrations.Count > 0)
                    {
                        <StatusPill Tone="warn">@L.F("{0} oczekujących", _db.PendingMigrations.Count)</StatusPill>
                    }
                </dd>
            </dl>
        }
    </div>

    <div class="card">
        <div class="card-title"><Icon Name="ai" /> @L.T("Silnik AI")</div>
        <AiStatusView Status="_ai" />
        <dl class="facts">
            <dt>@L.T("Silnik")</dt><dd>@(_ai?.EngineName ?? "Ollama") @(_ai?.EngineVersion is { } v ? $"v{v}" : "")</dd>
            <dt>@L.T("Endpoint")</dt><dd class="mono">@AiOptions.Value.Endpoint</dd>
            <dt>@L.T("Model")</dt><dd class="mono">@AiOptions.Value.Model</dd>
            <dt>@L.T("Uruchamianie")</dt><dd>@EngineHostText()</dd>
            @if (EngineHost.Runtime is { } runtime)
            {
                <dt>@L.T("Silnik (plik)")</dt><dd class="mono break">@runtime.Executable</dd>
                <dt>@L.T("Modele")</dt><dd class="mono break">@runtime.ModelsDirectory</dd>
            }
            @if (_ai?.InstalledModels.Count > 0)
            {
                <dt>@L.T("Zainstalowane")</dt><dd class="mono">@string.Join(", ", _ai.InstalledModels)</dd>
            }
        </dl>
        <button class="btn btn-ghost" @onclick="RefreshAiAsync" disabled="@_checkingAi"><Icon Name="refresh" Size="15" /> @L.T("Sprawdź ponownie")</button>
    </div>

    <div class="card span-2">
        <div class="card-title"><Icon Name="folder" /> @L.T("Dane i logi")</div>
        <p class="muted small">@L.T("Dane użytkownika nigdy nie są zapisywane w katalogu instalacyjnym. Logi rotują codziennie (maks. 10 MB na plik, 14 plików) i nie zawierają haseł ani tokenów.")</p>
        <dl class="facts">
            <dt>@L.T("Katalog danych")</dt><dd class="mono break">@Paths.Root</dd>
            <dt>@L.T("Logi")</dt><dd class="mono break">@Paths.LogsDirectory</dd>
            <dt>@L.T("Raporty")</dt><dd class="mono break">@Paths.ReportsDirectory</dd>
            <dt>@L.T("Eksporty")</dt><dd class="mono break">@Paths.ExportsDirectory</dd>
            <dt>@L.T("Baza podatności")</dt><dd class="mono break">@Paths.VulnerabilityDataDirectory</dd>
        </dl>
        <a class="btn btn-ghost" href="api/logs/download" download><Icon Name="download" Size="15" /> @L.T("Pobierz logi (ZIP)")</a>
    </div>
</section>

@code {
    private Weles.Infrastructure.Database.DatabaseInfo? _db;
    private AiEngineStatus? _ai;
    private bool _checkingAi;
    private bool _autostart;
    private string? _autostartError;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [Inject] private IAuthorizationService Authorization { get; set; } = default!;
    private bool _isAdmin;

    private sealed record LanAddress(string Address, string Label);
    private readonly List<LanAddress> _lanAddresses = [];
    private bool _lanEnabled;
    private string _lanAddress = "";
    private int _lanPort = PanelLanSettings.DefaultPort;
    private string? _lanMessage;
    private bool _lanError;

    private void SaveLan()
    {
        var settings = new PanelLanSettings(_lanEnabled, _lanAddress, _lanPort);
        if (_lanEnabled && settings.Validate(AgentListener.Active.Enabled ? AgentListener.Active.Port : -1) is { } error)
        {
            (_lanMessage, _lanError) = (error, true);
            return;
        }

        settings.Save(Paths);
        (_lanMessage, _lanError) = (L.T("Zapisano. Uruchom ponownie WELES, aby zmiana zaczęła działać."), false);
    }

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await Access.CanAsync(AuthState, Authorization, Policies.Admin);
        var lan = PanelLanSettings.Load(Paths);
        (_lanEnabled, _lanAddress, _lanPort) = (lan.Enabled, lan.Address, lan.Port);
        foreach (var nic in System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces().Where(n => n.OperationalStatus == System.Net.NetworkInformation.OperationalStatus.Up))
        {
            foreach (var u in nic.GetIPProperties().UnicastAddresses.Where(u => u.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork
                         && !System.Net.IPAddress.IsLoopback(u.Address) && !Weles.Core.Networking.AddressClassifier.IsPublic(u.Address)))
            {
                _lanAddresses.Add(new LanAddress(u.Address.ToString(), $"{u.Address} ({nic.Name}, {PanelLanState.SubnetOf(u.Address.ToString())})"));
            }
        }

        if (_lanAddress.Length > 0 && _lanAddresses.All(a => a.Address != _lanAddress)) _lanAddresses.Insert(0, new LanAddress(_lanAddress, _lanAddress));
        _autostart = Autostart.IsEnabled();
        _db = await DatabaseInfo.GetInfoAsync();
        _ai = await Ai.GetStatusAsync();
    }

    private string EngineHostText() => EngineHost.State switch
    {
        Weles.Infrastructure.AI.EngineHostState.Running => L.T("dołączony silnik uruchomiony przez WELES (tylko 127.0.0.1)"),
        Weles.Infrastructure.AI.EngineHostState.Starting => L.T("uruchamianie…"),
        Weles.Infrastructure.AI.EngineHostState.External => L.T("silnik już działał na tym adresie – WELES z niego korzysta"),
        Weles.Infrastructure.AI.EngineHostState.NotBundled => L.T("brak dołączonego silnika"),
        Weles.Infrastructure.AI.EngineHostState.Disabled => L.T("wyłączone w konfiguracji"),
        _ => L.Message(EngineHost.Message ?? L.T("błąd uruchamiania"))
    };

    private void ToggleAutostart(ChangeEventArgs e)
    {
        _autostartError = null;
        try
        {
            Autostart.Set(e.Value is true);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or System.Security.SecurityException)
        {
            _autostartError = L.F("Nie udało się zmienić ustawienia: {0}", ex.Message);
        }

        _autostart = Autostart.IsEnabled();
    }

    private async Task RefreshAiAsync()
    {
        _checkingAi = true;
        _ai = null;
        StateHasChanged();
        _ai = await Ai.GetStatusAsync();
        _checkingAi = false;
    }

}
