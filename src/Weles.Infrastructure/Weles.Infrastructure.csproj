<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Weles.Core\Weles.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Infrastruktura WELES: baza SQLite (EF Core, migracje), ścieżki danych użytkownika, silnik skanowania sieci (wykrywanie hostów, porty, rozpoznawanie usług, TLS, HTTP), baza producentów OUI, tablica ARP, kolejka skanów w tle oraz klient lokalnego silnika AI (Ollama).</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Discovery\Data\oui.txt.gz" LogicalName="Weles.oui.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Weles.Tests" />
  </ItemGroup>

</Project>
