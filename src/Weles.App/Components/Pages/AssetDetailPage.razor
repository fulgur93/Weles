@page "/assets/{AssetId:int}"
@using Weles.Infrastructure.Assets
@using Weles.Infrastructure.Queries
@using Weles.Core.Rules
@inject AssetQueries Queries
@inject AssetService AssetEditor
@inject NavigationManager Navigation
@inject RiskQueries RiskQueries
@inject Weles.Infrastructure.Risk.RiskAssessmentService RiskAssessment

<PageTitle>@(_detail?.Asset.DisplayName is { } title ? L.Message(title) : L.T("Urządzenie")) · WELES</PageTitle>

@if (_detail is null)
{
    <div class="card loading">@(_notFound ? L.T("Urządzenie nie istnieje.") : L.T("Wczytywanie…"))</div>
}
else
{
    var a = _detail.Asset;
    var latest = _detail.Latest;
    <div class="page-header">
        <div>
            <a class="back-link" href="assets"><Icon Name="arrow-left" Size="14" /> @L.T("Urządzenia")</a>
            <h1>@L.Message(a.DisplayName)</h1>
            <p class="page-subtitle">
                <span class="mono">@a.PrimaryIpAddress</span> · @Labels.Of(a.EffectiveType)@(a.UserAssetType is not null ? L.T(" (ustawiony ręcznie)") : "")
                · @L.T("krytyczność:") @Labels.Of(a.Criticality)
            </p>
        </div>
        <div class="header-actions">
            <span title="@Labels.Describe(_detail.Presence.Status)"><StatusPill Tone="@Labels.Tone(_detail.Presence.Status)">@Labels.Of(_detail.Presence.Status)</StatusPill></span>
            <Can Policy="@Policies.Modify"><button class="btn btn-ghost" @onclick="StartEdit"><Icon Name="settings" Size="15" /> @L.T("Edytuj")</button></Can>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="alert @(_messageIsError ? "alert-bad" : "alert-ok")">@_message</div>
    }

    @if (_edit is not null)
    {
        <section class="card editor">
            <div class="card-title"><Icon Name="settings" /> @L.T("Dane urządzenia (wprowadzane ręcznie)")</div>
            <p class="muted small">@L.T("Skany nigdy nie nadpisują tych pól. Krytyczność wpływa na ocenę ryzyka (Etap 5).")</p>
            <div class="form-grid">
                <label class="field"><span>@L.T("Nazwa")</span><input class="input" maxlength="255" @bind="_edit.Name" placeholder="@L.Message(AssetNaming.AutoName(a.Hostname, AssetNaming.Label(a.Model, a.Vendor), a.PrimaryIpAddress))" /><small class="muted">@L.T("Puste pole = nazwa automatyczna.")</small></label>
                <label class="field">
                    <span>@L.T("Typ urządzenia")</span>
                    <select class="input" @bind="_edit.Type">
                        <option value="">@L.F("Automatycznie ({0})", Labels.Of(a.AssetType))</option>
                        @foreach (var t in Enum.GetValues<AssetType>().Where(t => t != AssetType.Unknown)) { <option value="@t">@Labels.Of(t)</option> }
                    </select>
                </label>
                <label class="field">
                    <span>@L.T("Krytyczność dla organizacji")</span>
                    <select class="input" @bind="_edit.Criticality">
                        @foreach (var c in Enum.GetValues<AssetCriticality>()) { <option value="@c">@Labels.Of(c)</option> }
                    </select>
                </label>
                <label class="field"><span>@L.T("Notatki")</span><textarea class="input" rows="3" maxlength="4000" @bind="_edit.Notes" placeholder="@L.T("np. właściciel, lokalizacja, rola")"></textarea></label>
            </div>
            @if (_editErrors.Count > 0)
            {
                <div class="alert alert-bad"><ul>@foreach (var e in _editErrors) { <li>@L.Message(e)</li> }</ul></div>
            }
            <div class="actions">
                <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@L.T("Zapisz")</button>
                <button class="btn btn-ghost" @onclick="() => _edit = null">@L.T("Anuluj")</button>
            </div>
        </section>
    }

    <section class="grid-2">
        <div class="card">
            <div class="card-title"><Icon Name="assets" /> @L.T("Tożsamość")</div>
            <dl class="facts">
                <dt>@L.T("Adres IP")</dt><dd class="mono">@(a.PrimaryIpAddress ?? "—")</dd>
                <dt>@L.T("Nazwa hosta")</dt><dd>@(a.Hostname ?? "—")</dd>
                <dt>@L.T("Adres MAC")</dt><dd class="mono">@(a.MacAddress ?? "—")</dd>
                @if (Interfaces() is { Count: > 1 } nics)
                {
                    <dt>@L.T("Interfejsy")</dt>
                    <dd>
                        @foreach (var n in nics) { <div class="mono small">@n.Ip · @(n.Mac ?? "—")</div> }
                        @if (nics.Select(n => n.HostKey).Distinct().Count() == 1 && nics[0].HostKey is { } key)
                        {
                            <div class="muted small">@L.F("jedno urządzenie: identyczny klucz hosta SSH ({0})", key)</div>
                        }
                    </dd>
                }
                <dt>@L.T("Producent")</dt><dd>@(a.Vendor ?? "—")</dd>
                @if (a.Model is not null) { <dt>@L.T("Model")</dt><dd>@a.Model</dd> }
                <dt>@L.T("System")</dt><dd>@(a.OsFamily ?? L.T("nierozpoznany"))</dd>
                <dt>@L.T("Sieć")</dt><dd class="mono">@(a.NetworkSegment is { } seg ? NetworkNaming.Label(seg.Cidr, seg.Name, seg.GatewayVendor, seg.GatewayMac) : "—")</dd>
                <dt>@L.T("Pierwsze wykrycie")</dt><dd>@Labels.Local(a.FirstSeenAt)</dd>
                <dt>@L.T("Ostatnio widziane")</dt><dd>@Labels.Local(a.LastSeenAt)</dd>
                @if (latest is not null)
                {
                    <dt>@L.T("Wykryte przez")</dt><dd>@Labels.Of(latest.DiscoveryMethods)</dd>
                }
                <dt>@L.T("Status")</dt><dd>@Labels.Describe(_detail.Presence.Status)@(_detail.Presence.ReferenceScanId is { } rs ? L.F(" (skan #{0})", rs) : "")</dd>
            </dl>
            @if (!string.IsNullOrEmpty(a.Notes))
            {
                <div class="notes"><strong>@L.T("Notatki:")</strong> @a.Notes</div>
            }
        </div>

        <div class="card">
            <div class="card-title"><Icon Name="info" /> @L.T("Klasyfikacja")</div>
            <p>
                <strong>@Labels.Of(a.AssetType)</strong>
                @if (latest is not null) { <span class="muted small"> · @L.F("pewność {0}%", latest.ClassificationConfidence)</span> }
                @if (a.UserAssetType is { } user) { <span class="muted small"> @L.T("· nadpisane ręcznie na:") <strong>@Labels.Of(user)</strong></span> }
            </p>
            @if (!string.IsNullOrEmpty(a.ClassificationReasons))
            {
                <ul class="checklist">
                    @foreach (var r in a.ClassificationReasons.Split('\n')) { <li><Icon Name="layers" Size="14" /> @L.Message(r)</li> }
                </ul>
            }
            <div class="card-title" style="margin-top:18px"><Icon Name="risk" /> @L.T("Ryzyko i podatności")</div>
            <dl class="facts">
                <dt>@L.T("Ocena ryzyka")</dt><dd>@if (a.CurrentRiskScore is { } score) { <StatusPill Tone="@Labels.Tone(a.CurrentRiskLevel)">@score.ToString("0") · @(a.CurrentRiskLevel is { } lvl ? Labels.Of(lvl) : "")</StatusPill> <a class="small" href="#risk">@L.T("dlaczego?")</a> } else { <span class="muted">@L.T("brak – urządzenie nie było jeszcze ocenione")</span> }</dd>
                <dt>@L.T("Podatności")</dt><dd>@VulnerabilitySummary()</dd>
                <dt>@L.T("Relacje")</dt><dd class="muted">@L.T("powiązania z innymi urządzeniami – Etap 7 (Topologia sieci)")</dd>
            </dl>
        </div>
    </section>

    @if (_risk is { } risk)
    {
        <section class="card" id="risk">
            <div class="card-title"><Icon Name="risk" /> @L.T("Ocena ryzyka")
                <StatusPill Tone="@Labels.Tone(risk.Result.Level)">@risk.Result.Score.ToString("0") · @Labels.Of(risk.Result.Level)</StatusPill>
                <span class="muted small">· <a href="scans/@risk.ScanId">@L.F("Skan #{0}", risk.ScanId)</a> · @Labels.Local(risk.AssessedAt)</span>
                <a class="btn btn-ghost btn-sm" style="margin-left:auto" href="ai?asset=@AssetId"><Icon Name="ai" Size="14" /> @L.T("Zapytaj Analityka AI")</a>
            </div>
            <div class="grid-2 risk-detail">
                <div>
                    <div class="subtitle">@L.T("Jak powstał wynik")</div>
                    <ul class="factor-list">
                        @foreach (var f in risk.Result.Factors) { <li><span>@L.Message(f.Text)</span>@if (f.Points != 0) { <span class="mono">@f.Points.ToString("+0.#;-0.#")</span> }</li> }
                        <li class="factor-total"><span>@L.T("Razem (0–100)")</span><span class="mono">@risk.Result.Score.ToString("0.#")</span></li>
                    </ul>
                    @if (risk.History.Count > 1)
                    {
                        <p class="muted small">@L.T("Historia:") @string.Join(" → ", risk.History.Select(h => h.Score.ToString("0")))</p>
                    }
                </div>
                <div>
                    <div class="subtitle">@L.T("Problemy do naprawy")</div>
                    @if (risk.Result.Issues.Count == 0)
                    {
                        <p class="muted">@L.T("Brak wykrytych problemów i dopasowanych podatności.")</p>
                    }
                    <ol class="issue-list">
                        @foreach (var i in risk.Result.Issues)
                        {
                            <li>
                                <div><StatusPill Tone="@Labels.Tone(i.Level)">@i.Score.ToString("0")</StatusPill> <strong>@L.Message(i.Title)</strong></div>
                                <ul class="reasons-list small">@foreach (var r in i.Reasons) { <li>@L.Message(r)</li> }</ul>
                                <div class="small">@L.Message(i.Recommendation)</div>
                                <AttackChips Techniques="i.AttackTechniques" />
                            </li>
                        }
                    </ol>
                </div>
            </div>
            @if (risk.Findings.Count > 0)
            {
                <div class="subtitle" style="margin-top:14px">@L.T("Problemy konfiguracji")</div>
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th>@L.T("Problem")</th><th>@L.T("Port")</th><th>@L.T("Dowód")</th><th>@L.T("Pewność")</th><th>@L.T("Status")</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var f in risk.Findings)
                            {
                                <tr>
                                    <td>@L.Message(f.Title)</td>
                                    <td class="mono">@(f.Port?.ToString() ?? "—")</td>
                                    <td class="small">@L.Message(f.Evidence)</td>
                                    <td>@f.Confidence%</td>
                                    <td><StatusPill Tone="@Labels.Tone(f.Status)">@Labels.Of(f.Status)</StatusPill>@if (f.ResolvedAt is { } r) { <div class="muted small">@Labels.Local(r)</div> }</td>
                                    <td><Can Policy="@Policies.Modify">
                                        @if (f.Status == FindingStatus.Open) { <button class="btn btn-ghost btn-sm" title="@L.T("Ryzyko świadomie zaakceptowane (np. urządzenie odizolowane). Dopasowanie zostaje w historii.")" @onclick="() => SetFindingAsync(f.Id, FindingStatus.Accepted)">@L.T("Akceptuj ryzyko")</button> }
                                        else if (f.Status == FindingStatus.Accepted) { <button class="btn btn-ghost btn-sm" @onclick="() => SetFindingAsync(f.Id, FindingStatus.Open)">@L.T("Otwórz ponownie")</button> }
                                    </Can></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="card">
        <div class="card-title"><Icon Name="scans" /> @L.T("Aktualne usługi")
            @if (latest is not null) { <span class="muted small">@L.T("· ostatnia obserwacja: skan") <a href="scans/@latest.ScanId">#@latest.ScanId</a> (@Labels.Local(latest.DiscoveredAt))</span> }
        </div>
        @if (latest is not null && _detail.CurrentPorts.Where(p => p.DiscoveredHostId != latest.Id).ToList() is { Count: > 0 } carried)
        {
            <p class="muted small">@L.F("Porty {0} pochodzą z wcześniejszych skanów – ostatni skan ich nie sprawdzał (inny profil portów).", string.Join(", ", carried.Select(p => p.Port)))</p>
        }
        @if (latest is null)
        {
            <p class="muted">@L.T("Brak zakończonych obserwacji.")</p>
        }
        else
        {
            <AnnouncedServices Host="latest" />
            <ServiceTable Ports="_detail.CurrentPorts" ShowEmpty="true" />
        }
    </section>

    @if (_detail.Vulnerabilities.Count > 0)
    {
        var shown = _detail.Vulnerabilities.Where(v => _showAllVulns || v.Status != FindingStatus.Resolved).ToList();
        <section class="card">
            <div class="card-title"><Icon Name="vulnerabilities" /> @L.T("Podatności")
                <span class="muted small">@L.T("· dopasowane do aktualnych usług i modelu urządzenia")</span>
                @if (_detail.Vulnerabilities.Any(v => v.Status == FindingStatus.Resolved))
                {
                    <button class="btn btn-ghost btn-sm" style="margin-left:auto" @onclick="() => _showAllVulns = !_showAllVulns">@(_showAllVulns ? L.T("Ukryj rozwiązane") : L.T("Pokaż rozwiązane"))</button>
                }
            </div>
            <div class="table-wrap">
                <table class="table table-hover">
                    <thead><tr><th>@L.T("CVE")</th><th>@L.T("Wykryto")</th><th>@L.T("CVSS")</th><th>@L.T("EPSS")</th><th>@L.T("KEV")</th><th>@L.T("Dopasowanie")</th><th>@L.T("Status")</th></tr></thead>
                    <tbody>
                        @foreach (var v in shown)
                        {
                            <tr class="clickable" title="@L.Message(v.MatchReason)" @onclick="@(() => Navigation.NavigateTo($"vulnerabilities/{v.Vulnerability!.CveId}"))">
                                <td class="mono"><strong>@v.Vulnerability!.CveId</strong>@if (v.Vulnerability.Title is not null) { <div class="muted small">@v.Vulnerability.Title</div> }</td>
                                <td>@v.Product @v.DetectedVersion @if (v.Port is { } p) { <span class="muted small">· @L.F("port {0}", p)</span> }</td>
                                <td>@if (v.Vulnerability.CvssScore is { } c) { <StatusPill Tone="@Labels.Tone(v.Vulnerability.Severity)">@c.ToString("0.0")</StatusPill> } else { <span class="muted">—</span> }</td>
                                <td class="mono small">@Labels.Epss(v.Vulnerability.EpssScore)</td>
                                <td>@if (v.Vulnerability.IsKnownExploited) { <StatusPill Tone="bad">@L.T("KEV")</StatusPill> } else { <span class="muted">—</span> }</td>
                                <td title="@Labels.Describe(v.MatchStatus)"><StatusPill Tone="@Labels.Tone(v.MatchStatus)">@Labels.Of(v.MatchStatus)</StatusPill> <span class="muted small">@v.MatchConfidence%</span></td>
                                <td><StatusPill Tone="@Labels.Tone(v.Status)">@Labels.Of(v.Status)</StatusPill></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="card">
        <div class="card-title"><Icon Name="clock" /> @L.T("Historia obserwacji i zmian")</div>
        <ol class="timeline">
            @foreach (var item in Timeline())
            {
                <li class="timeline-item @(item.Absence is not null ? "absent" : "")">
                    @if (item.Observation is { } o)
                    {
                        <div class="timeline-head">
                            <a href="scans/@o.ScanId"><strong>@L.F("Skan #{0}", o.ScanId)</strong></a> <span class="muted">· @L.Message(o.ScanTargetName) · @Labels.Local(o.ScanStartedAt)</span>
                        </div>
                        <div class="small muted">
                            <span class="mono">@o.Host.IpAddress</span> @L.T("· profil portów") <span class="mono">@o.Host.Scan?.PortSpecification</span> · @L.T("otwarte porty:") @o.Host.Ports.Count@(o.Host.Ports.Count > 0 ? $" ({string.Join(", ", o.Host.Ports.OrderBy(p => p.Port).Select(p => p.Port))})" : "")
                        </div>
                        @if (o == _detail.Observations[^1])
                        {
                            <div class="change tone-info">@L.T("Pierwsze wykrycie urządzenia")</div>
                        }
                        else if (o.ChangesSincePrevious.Count == 0)
                        {
                            <div class="small muted">@L.T("Bez zmian względem poprzedniej obserwacji")</div>
                        }
                        @foreach (var c in o.ChangesSincePrevious)
                        {
                            <div class="change tone-@Labels.Tone(c.Kind)">@L.Message(c.Description)</div>
                        }
                    }
                    else if (item.Absence is { } miss)
                    {
                        <div class="timeline-head"><a href="scans/@miss.ScanId"><strong>@L.F("Skan #{0}", miss.ScanId)</strong></a> <span class="muted">· @Labels.Local(miss.StartedAt)</span></div>
                        <div class="change tone-warn">@L.T("Nie wykryto – adres był w zakresie skanu")</div>
                    }
                </li>
            }
        </ol>
    </section>
}

@code {
    private bool _showAllVulns;
    private AssetRiskDetail? _risk;

    private sealed record Nic(string Ip, string? Mac, string? HostKey);

    /// <summary>Addresses the device answered on in its latest scan (e.g. cable and Wi‑Fi), with the evidence that joins them.</summary>
    private List<Nic> Interfaces()
    {
        if (_detail?.Latest is not { } latest) return [];
        return _detail.Observations.Where(o => o.ScanId == latest.ScanId)
            .Select(o => new Nic(o.Host.IpAddress, o.Host.MacAddress,
                o.Host.Ports.Select(p => ServiceDetails.Extra(p.Service).GetValueOrDefault("ssh.hostKey")).FirstOrDefault(k => k is not null)))
            .DistinctBy(n => (n.Ip, n.Mac)).OrderBy(n => n.Ip, StringComparer.Ordinal).ToList();
    }

    private async Task SetFindingAsync(int id, FindingStatus status)
    {
        await RiskQueries.SetFindingStatusAsync(id, status);
        // The decision changes the score at once – re-assess the latest scan of this device.
        if (await RiskQueries.LatestScanOfAssetAsync(AssetId) is { } scanId) await RiskAssessment.RefreshScanAsync(scanId);
        await LoadAsync();
    }

    private string VulnerabilitySummary()
    {
        var open = _detail!.Vulnerabilities.Where(v => v.Status == FindingStatus.Open).ToList();
        if (_detail.Vulnerabilities.Count == 0) return L.T("brak dopasowań do lokalnej bazy podatności");
        var real = open.Count(v => v.MatchStatus != VulnerabilityMatchStatus.InsufficientData);
        var model = open.Count - real;
        var parts = new List<string> { L.F("{0} otwartych", real) };
        if (open.Count(v => v.Vulnerability!.IsKnownExploited) is > 0 and var kev) parts.Add(L.F("{0} w CISA KEV", kev));
        if (model > 0) parts.Add(L.F("{0} dla modelu urządzenia – wymaga sprawdzenia wersji firmware", model));
        return string.Join(" · ", parts);
    }

    [Parameter] public int AssetId { get; set; }

    private sealed class EditModel
    {
        public string? Name { get; set; }
        public string Type { get; set; } = "";
        public AssetCriticality Criticality { get; set; }
        public string? Notes { get; set; }
    }

    private sealed record TimelineItem(DateTime At, AssetObservation? Observation, CompletedScanCoverage? Absence);

    private AssetDetail? _detail;
    private bool _notFound;
    private EditModel? _edit;
    private List<string> _editErrors = [];
    private bool _saving;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _detail = await Queries.GetAsync(AssetId);
        _risk = _detail is null ? null : await RiskQueries.AssetAsync(AssetId);
        _notFound = _detail is null;
    }

    private IEnumerable<TimelineItem> Timeline() =>
        _detail!.Observations.Select(o => new TimelineItem(o.ScanStartedAt, o, null))
            .Concat(_detail.Absences.Select(s => new TimelineItem(s.StartedAt, null, s)))
            .OrderByDescending(i => i.At);

    private void StartEdit()
    {
        var a = _detail!.Asset;
        _edit = new EditModel { Name = a.CustomName, Type = a.UserAssetType?.ToString() ?? "", Criticality = a.Criticality, Notes = a.Notes };
        _editErrors = [];
        _message = null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var result = await AssetEditor.UpdateAsync(AssetId, new AssetEditInput(
            _edit!.Name, Enum.TryParse<AssetType>(_edit.Type, out var t) ? t : null, _edit.Criticality, _edit.Notes));
        _saving = false;
        if (!result.Success)
        {
            _editErrors = [.. result.Errors];
            return;
        }

        _edit = null;
        _message = L.T("Zapisano.");
        _messageIsError = false;
        await LoadAsync();
    }
}
