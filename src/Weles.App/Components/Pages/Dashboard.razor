@page "/"
@inject Weles.Infrastructure.Queries.DashboardQueries Queries
@inject IAiService Ai
@inject Weles.Infrastructure.Queries.RiskQueries RiskQueries
@inject Weles.Infrastructure.Queries.NetworkQueries Networks
@using Weles.Infrastructure.Queries

<PageTitle>@L.T("Pulpit · WELES")</PageTitle>

<div class="page-header">
    <div>
        <h1>@L.T("Pulpit")</h1>
        <p class="page-subtitle">@L.T("Stan bezpieczeństwa infrastruktury na podstawie rzeczywistych wyników skanowania.")</p>
    </div>
    @if (_networks is not null && _summary?.HasAnyScan == true) { <NetworkPicker Context="_networks" Value="@_filter" /> }
</div>
@if (_networks is not null && _networks.Networks.Count > 1 && _summary?.HasAnyScan == true)
{
    <p class="muted small page-network">@NetworkPicker.Describe(_networks, _filter)</p>
}

@if (_summary is null)
{
    <div class="card loading">@L.T("Wczytywanie danych…")</div>
}
else if (!_summary.HasAnyScan)
{
    <section class="hero card">
        <div class="hero-body">
            <div class="eyebrow">@L.T("Pierwsze uruchomienie")</div>
            <h2>@L.T("Brak wykonanych audytów")</h2>
            <p>
                @L.T("WELES nie wyświetla żadnych przykładowych ani szacunkowych liczb. Pulpit wypełni się danymi po pierwszym")
                @L.T("skanowaniu zatwierdzonego zakresu sieci.")
            </p>
            <ol class="steps">
                <li><span class="step-no">1</span><div><strong>@L.T("Zdefiniuj i zatwierdź zakres")</strong><span>@L.T("sieć lokalna wykryta automatycznie albo własne adresy IP, CIDR i domeny")</span></div></li>
                <li><span class="step-no">2</span><div><strong>@L.T("Uruchom wykrywanie")</strong><span>@L.T("urządzenia, porty, usługi, wersje i certyfikaty TLS")</span></div></li>
                <li><span class="step-no">3</span><div><strong>@L.T("Przeanalizuj ryzyko")</strong><span>@L.T("podatności, priorytety napraw i wyjaśnienia lokalnego AI")</span></div></li>
            </ol>
            <div class="hero-actions">
                <a class="btn btn-primary" href="discovery"><Icon Name="play" Size="16" /> @L.T("Rozpocznij pierwszy audyt")</a>
                <span class="muted small">@L.T("WELES zaproponuje zakres na podstawie sieci tego komputera.")</span>
            </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
            <BrandMark Size="160" />
        </div>
    </section>
}
else
{
    <section class="kpi-grid">
        <a class="kpi card kpi-link" href="@NetLink("risk")">
            <div class="kpi-label">@L.T("Ocena stanu bezpieczeństwa")</div>
            <div class="kpi-value @(_summary.SecurityPostureScore is { } ps ? "tone-" + RiskPage.PostureTone(ps) : "")">@(_summary.SecurityPostureScore is { } s ? s.ToString("0") : "—")</div>
            <div class="kpi-hint">@(_summary.SecurityPostureScore is null ? L.T("pojawi się po pierwszym skanie") : L.T("0–100, wyżej = lepiej"))</div>
        </a>
        <a class="kpi card kpi-link" href="@NetLink("assets")"><div class="kpi-label">@L.T("Urządzenia")</div><div class="kpi-value">@_summary.AssetCount</div><div class="kpi-hint">@L.F("nowe od ostatniego skanu: {0}", _summary.NewAssetsSinceLastScan)</div></a>
        <div class="kpi card"><div class="kpi-label">@L.T("Aktywne usługi")</div><div class="kpi-value">@_summary.ActiveServiceCount</div><div class="kpi-hint">@L.T("otwarte porty w ostatnim skanie")</div></div>
        <div class="kpi card"><div class="kpi-label">@L.T("Podatności")</div><div class="kpi-value">@_summary.VulnerabilityCount</div><div class="kpi-hint">@L.T("otwarte dopasowania (bez „brak danych”)")</div></div>
        <a class="kpi card kpi-critical kpi-link" href="@NetLink("risk")"><div class="kpi-label">@L.T("Krytyczne problemy")</div><div class="kpi-value">@_summary.CriticalFindingCount</div><div class="kpi-hint">@L.T("w ostatnim skanie")</div></a>
    </section>

    @if (_priorities is { Count: > 0 })
    {
        <section class="card">
            <div class="card-title"><Icon Name="alert" /> @L.T("Priorytety napraw") <a class="small" href="@NetLink("risk")" style="margin-left:auto">@L.T("Wszystkie")</a></div>
            <ol class="priority-list compact">
                @foreach (var (p, i) in _priorities.Select((p, i) => (p, i)))
                {
                    <li class="priority">
                        <a class="priority-head" href="assets/@p.AssetId">
                            <span class="priority-rank">@(i + 1)</span>
                            <StatusPill Tone="@Labels.Tone(p.Level)">@p.Priority.ToString("0")</StatusPill>
                            <span class="priority-title">@L.Message(p.Issue.Title)</span>
                            <span class="muted small">@L.Message(p.AssetName) · <span class="mono">@p.AssetIp</span></span>
                            @if (p.Issue.KnownExploited > 0) { <StatusPill Tone="bad">@L.T("KEV")</StatusPill> }
                        </a>
                    </li>
                }
            </ol>
        </section>
    }

    @if (_summary.LastScan is { } last)
    {
        <section class="card">
            <div class="card-title"><Icon Name="clock" /> @L.T("Ostatnie skanowanie")</div>
            <dl class="facts">
                <dt>@L.T("Zakres")</dt><dd>@L.Message(last.TargetName)</dd>
                <dt>@L.T("Zakończone")</dt><dd>@last.CompletedAt?.ToLocalTime().ToString("g")</dd>
                <dt>@L.T("Aktywne hosty")</dt><dd>@last.HostsAlive</dd>
                <dt>@L.T("Otwarte porty")</dt><dd>@last.OpenPorts</dd>
            </dl>
            <a class="btn btn-ghost btn-sm" href="scans/@last.Id">@L.T("Szczegóły skanu")</a>
        </section>
    }
}

<section class="grid-3">
    <div class="card">
        <div class="card-title"><Icon Name="database" /> @L.T("Baza danych")</div>
        <StatusPill Tone="ok">@L.T("Gotowa")</StatusPill>
        <p class="muted small">@L.F("Lokalna baza SQLite, migracje zastosowane. Zakończone skany: {0}.", _summary?.CompletedScanCount ?? 0)</p>
    </div>
    <div class="card">
        <div class="card-title"><Icon Name="vulnerabilities" /> @L.T("Baza podatności")</div>
        @if (_summary?.VulnerabilityDatabaseUpdatedAt is { } updated)
        {
            <StatusPill Tone="ok">@L.F("Dane z {0}", updated.ToLocalTime().ToString("d"))</StatusPill>
            <p class="muted small"><a href="vulnerabilities">@L.T("Szczegóły i aktualizacja")</a></p>
        }
        else
        {
            <StatusPill Tone="muted">@L.T("Wczytywanie bazy…")</StatusPill>
            <p class="muted small">@L.T("Lokalna baza NVD / CISA KEV / EPSS jest importowana w tle przy pierwszym uruchomieniu.")</p>
        }
    </div>
    <div class="card">
        <div class="card-title"><Icon Name="ai" /> @L.T("Lokalne AI")</div>
        <AiStatusView Status="_ai" />
    </div>
</section>

@code {
    private DashboardSummary? _summary;
    private AiEngineStatus? _ai;
    private IReadOnlyList<RemediationItem>? _priorities;
    private NetworkContext? _networks;
    private string _filter = NetworkContext.All;

    [SupplyParameterFromQuery(Name = "net")] public string? NetworkParameter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _networks = await Networks.ContextAsync();
        _filter = _networks.Normalize(NetworkParameter);
        var networks = _networks;
        var filter = _filter;
        _summary = await Queries.GetSummaryAsync(networks, filter);
        _priorities = await RiskQueries.PrioritiesAsync(3, id => networks.IncludesAsset(filter, id));
        _ai ??= await Ai.GetStatusAsync();
    }

    /// <summary>Links keep the chosen network; the asset list understands only "current" and "all".</summary>
    private string NetLink(string page) => page == "assets"
        ? (_filter is NetworkContext.All or NetworkContext.Current ? $"assets?net={_filter}" : "assets")
        : $"{page}?net={Uri.EscapeDataString(_filter)}";
}
