@if (Status is null)
{
    <StatusPill Tone="muted">@L.T("Sprawdzanie…")</StatusPill>
}
else
{
    switch (Status.State)
    {
        case AiEngineState.Ready:
            <StatusPill Tone="ok">@L.T("Gotowe") · @Status.ConfiguredModel</StatusPill>
            break;
        case AiEngineState.ModelMissing:
            <StatusPill Tone="warn">@L.T("Brak modelu")</StatusPill>
            break;
        default:
            <StatusPill Tone="muted">@L.T("Niedostępne")</StatusPill>
            break;
    }

    @if (!string.IsNullOrEmpty(Status.Message))
    {
        <p class="muted small">@L.Message(Status.Message) @(Status.State == AiEngineState.Unavailable ? L.T("Dołączenie silnika Ollama i modelu do instalatora – Etap 6. Pozostałe moduły działają bez AI.") : "")</p>
    }
}

@code {
    [Parameter] public AiEngineStatus? Status { get; set; }
}
