@page "/vulnerabilities"
@using Weles.Infrastructure.Queries
@using Weles.Infrastructure.Vulnerabilities
@implements IDisposable
@inject VulnerabilityQueries Queries
@inject VulnerabilityDatabaseService Database
@inject NavigationManager Navigation

<PageTitle>Vulnerabilities · WELES</PageTitle>

<div class="page-header">
    <div>
        <h1>Vulnerabilities</h1>
        <p class="page-subtitle">Wykryte wersje oprogramowania i modele urządzeń dopasowane do lokalnej bazy NVD, CISA KEV i EPSS. Podobny numer wersji nigdy nie wystarcza – każde dopasowanie ma status i uzasadnienie.</p>
    </div>
</div>

<section class="card">
    <div class="card-title"><Icon Name="vulnerabilities" /> Lokalna baza podatności</div>
    @if (_status is null)
    {
        <p class="muted">Wczytywanie…</p>
    }
    else
    {
        var st = _status.State;
        <div class="vulndb-grid">
            <dl class="facts">
                <dt>CVE w bazie</dt><dd>@_status.CveCount.ToString("N0") <span class="muted small">(produkty, które WELES rozpoznaje)</span></dd>
                <dt>NVD</dt><dd>@(st.NvdUpdatedAt is { } n ? Labels.Local(n) : "brak danych")</dd>
                <dt>CISA KEV</dt><dd>@(st.KevVersion ?? "brak") <span class="muted small">· @_status.KevCount wykorzystywanych w atakach</span></dd>
                <dt>EPSS</dt><dd>@(st.EpssScoreDate is { } e ? e.ToLocalTime().ToString("d") : "brak") <span class="muted small">· wyniki dla @_status.EpssCount CVE</span></dd>
                <dt>Źródło</dt><dd>@(st.Source switch { "online" => "pobrane z Internetu", "snapshot" => $"baza dołączona do WELES (zbudowana {st.SnapshotCreatedAt?.ToLocalTime():d})", _ => "brak" })</dd>
                @if (st.LastOnlineAttemptAt is { } attempt)
                {
                    <dt>Ostatnia aktualizacja online</dt>
                    <dd>@Labels.Local(attempt) @if (st.LastOnlineError is { } err) { <span class="detail-warn small"> · częściowo nieudana: @err</span> } else { <span class="tone-ok small"> · zakończona</span> }</dd>
                }
            </dl>
            <div class="vulndb-update">
                @if (_status.IsUpdating)
                {
                    <p><StatusPill Tone="info">Aktualizacja w toku</StatusPill></p>
                    <p class="muted small mono break">@_status.Progress</p>
                    <button class="btn btn-ghost btn-sm" @onclick="Cancel">Przerwij</button>
                }
                else
                {
                    <button class="btn btn-primary btn-sm" @onclick="Update"><Icon Name="refresh" Size="14" /> Aktualizuj z Internetu</button>
                    <p class="muted small">Pobiera publiczne dane z services.nvd.nist.gov, cisa.gov i epss.empiricalsecurity.com. Zapytania zawierają tylko stałą listę produktów WELES – nic o Twojej sieci. Bez Internetu WELES używa ostatnio pobranej bazy. NVD bez klucza API pozwala na 5 zapytań / 30 s, więc pełne pobranie trwa ok. 5 minut.</p>
                }
            </div>
        </div>
    }
</section>

<section class="card">
    @if (_page is null)
    {
        <p class="muted">Wczytywanie…</p>
    }
    else
    {
        <div class="toolbar">
            <div class="search">
                <Icon Name="discovery" Size="15" />
                <input class="input" placeholder="Szukaj: CVE, urządzenie, IP, produkt, wersja, port…" @bind="_search" @bind:event="oninput" @bind:after="Refresh" />
            </div>
            <label class="checkbox inline"><input type="checkbox" @bind="_kevOnly" @bind:after="Refresh" /><span>Tylko CISA KEV (@_page.KnownExploited)</span></label>
            <label class="checkbox inline"><input type="checkbox" @bind="_includeResolved" @bind:after="Refresh" /><span>Pokaż rozwiązane</span></label>
        </div>

        <div class="status-tabs">
            <button class="@(_match is null ? "active" : "")" @onclick="() => SetMatch(null)">Wszystkie <span>@_page.Total</span></button>
            @foreach (var s in Enum.GetValues<VulnerabilityMatchStatus>())
            {
                <button class="@(_match == s ? "active" : "")" title="@Labels.Describe(s)" @onclick="() => SetMatch(s)">
                    <span class="pill-dot tone-@Labels.Tone(s)"></span>@Labels.Of(s) <span>@_page.MatchStatusCounts[s]</span>
                </button>
            }
        </div>

        @if (_page.Items.Count == 0)
        {
            <div class="empty">
                @if (_page.Total == 0 && string.IsNullOrWhiteSpace(_search) && !_kevOnly)
                {
                    <p>Brak dopasowań. Podatności są dopasowywane po każdym skanie – do wykrytych wersji usług (baner, protokół) i do modelu urządzenia. Usługa bez wersji nie daje dopasowania.</p>
                }
                else
                {
                    <p>Brak dopasowań dla wybranych filtrów.</p>
                }
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table table-hover">
                    <thead><tr><th>CVE</th><th>Urządzenie</th><th>Wykryto</th><th>CVSS</th><th>EPSS</th><th>KEV</th><th>Dopasowanie</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var f in _page.Items.Take(_limit))
                        {
                            <tr class="clickable" @onclick="@(() => Navigation.NavigateTo($"vulnerabilities/{f.CveId}"))" title="@f.MatchReason">
                                <td class="mono"><strong>@f.CveId</strong>@if (f.Title is not null) { <div class="muted small">@f.Title</div> }</td>
                                <td><a href="assets/@f.AssetId" @onclick:stopPropagation="true">@f.AssetName</a><div class="muted small mono">@f.AssetIp</div></td>
                                <td>@f.Product @f.DetectedVersion @if (f.Port is { } p) { <span class="muted small">· port @p</span> }</td>
                                <td>@if (f.CvssScore is { } c) { <StatusPill Tone="@Labels.Tone(f.Severity)">@c.ToString("0.0")</StatusPill> } else { <span class="muted">—</span> }</td>
                                <td class="mono small" title="@(f.EpssPercentile is { } pc ? $"percentyl {pc * 100:0.#}" : null)">@Labels.Epss(f.EpssScore)</td>
                                <td>@if (f.IsKnownExploited) { <StatusPill Tone="bad">KEV</StatusPill> } else { <span class="muted">—</span> }</td>
                                <td title="@Labels.Describe(f.MatchStatus)"><StatusPill Tone="@Labels.Tone(f.MatchStatus)">@Labels.Of(f.MatchStatus)</StatusPill> <span class="muted small">@f.MatchConfidence%</span></td>
                                <td><StatusPill Tone="@Labels.Tone(f.Status)">@Labels.Of(f.Status)</StatusPill></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_page.Items.Count > _limit)
            {
                <div class="pager"><span class="muted small">Pokazano @_limit z @_page.Items.Count</span><button class="btn btn-ghost btn-sm" @onclick="() => _limit += 100">Pokaż więcej</button></div>
            }
        }
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "match")] public string? MatchParameter { get; set; }
    [SupplyParameterFromQuery(Name = "kev")] public bool Kev { get; set; }

    private VulnerabilityDatabaseStatus? _status;
    private VulnerabilityFindingPage? _page;
    private string? _search;
    private bool _kevOnly;
    private bool _includeResolved;
    private VulnerabilityMatchStatus? _match;
    private int _limit = 100;

    protected override async Task OnInitializedAsync()
    {
        if (Enum.TryParse<VulnerabilityMatchStatus>(MatchParameter, true, out var m)) _match = m;
        _kevOnly = Kev;
        Database.Changed += OnDatabaseChanged;
        _status = await Database.GetStatusAsync();
        await Refresh();
    }

    private async Task Refresh()
    {
        _limit = 100;
        _page = await Queries.FindingsAsync(new VulnerabilityFindingQuery { Search = _search, MatchStatus = _match, KnownExploitedOnly = _kevOnly, IncludeResolved = _includeResolved });
    }

    private async Task SetMatch(VulnerabilityMatchStatus? status)
    {
        _match = status;
        await Refresh();
    }

    private async Task Update()
    {
        Database.StartOnlineUpdate();
        _status = await Database.GetStatusAsync();
    }

    private void Cancel() => Database.CancelOnlineUpdate();

    private void OnDatabaseChanged() => _ = InvokeAsync(async () =>
    {
        _status = await Database.GetStatusAsync();
        if (!_status.IsUpdating) await Refresh();
        StateHasChanged();
    });

    public void Dispose() => Database.Changed -= OnDatabaseChanged;
}
